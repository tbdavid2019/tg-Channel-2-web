---
import '../assets/normalize.css'
import '../assets/style.css'
import '../assets/global.css'
import { getEnv, ASSET_VERSION, assetUrl } from '../lib/env'
import { uiTranslations } from '../lib/i18n'
import backToTopIcon from '../assets/back-to-top.svg'
import PopularChannels from '../components/popular-channels.astro'
import RandomRecommendation from '../components/random-recommendation.astro'

const { SITE_URL, RSS_URL, RSS_PREFIX } = Astro.locals
const { channel } = Astro.props

const locale = getEnv(import.meta.env, Astro, 'LOCALE')
const GA_MEASUREMENT_ID = getEnv(import.meta.env, Astro, 'GA_MEASUREMENT_ID')

const seo = channel?.seo
const brand = '888 Telegram 頻道瀏覽器'
const siteBase = new URL(SITE_URL || Astro.url.origin, Astro.url.origin)
siteBase.protocol = 'https:'
const siteOrigin = siteBase.origin
const currentPath = Astro.url.pathname === '/' ? '' : Astro.url.pathname.replace(/\/+$/, '')
const canonical = `${siteOrigin}${currentPath}`
const twitter = getEnv(import.meta.env, Astro, 'TWITTER')
const twitterHandle = String(twitter || 'oobwei').replace(/^@/, '')
const pageTitle = channel?.isReaderHome
  ? `${brand}｜公開頻道與文章閱讀`
  : seo?.title && ['Tags', 'Links'].includes(seo.title)
    ? `${seo.title}｜${brand}`
    : `${channel?.title || brand}｜Telegram 公開頻道閱讀器`
const genericDescription = '888 Telegram 頻道瀏覽器：輸入公開頻道的 @username、裸 username 或 t.me 連結，閱讀文章、圖片與日期分組內容；私人、邀請連結與沒有公開預覽的內容會顯示支援狀態。'
const channelDescription = String(seo?.text ?? channel?.description ?? '').replace(/\s+/g, ' ').trim()
const description = channel?.isReaderHome || !channelDescription
  ? genericDescription
  : `${channelDescription}｜在 888 Telegram 頻道瀏覽器閱讀公開文章、圖片與日期分組內容，支援依日期瀏覽、RSS 訂閱與桌面／手機閱讀；私人、邀請連結與沒有公開預覽的內容會顯示支援狀態。`.slice(0, 160)
const ogImage = `${siteOrigin}${assetUrl('/og-image.png')}`
const ogLocale = String(locale || 'zh-tw').toLowerCase() === 'zh-tw' ? 'zh_TW' : locale
const isEnabled = value => value === true || ['true', '1', 'yes'].includes(String(value || '').toLowerCase())
const noindex = isEnabled(seo?.noindex ?? getEnv(import.meta.env, Astro, 'NOINDEX'))
const nofollow = isEnabled(seo?.nofollow ?? getEnv(import.meta.env, Astro, 'NOFOLLOW'))
const robots = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow'].join(', ')
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': channel?.isReaderHome ? 'WebSite' : 'WebPage',
  name: pageTitle,
  description,
  url: canonical,
  inLanguage: ['zh-Hant', 'en'],
  isPartOf: {
    '@type': 'WebSite',
    name: brand,
    url: `${siteOrigin}/`,
  },
}).replace(/</g, '\\u003c')

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: brand,
    item: `${siteOrigin}/`,
  },
]
if (!channel?.isReaderHome && channel?.title && channel?.title !== brand) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: channel.title,
    item: canonical,
  })
}
const breadcrumbStructuredData = breadcrumbItems.length > 1 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
}).replace(/</g, '\\u003c') : null
const initialLanguage = String(locale || '').toLowerCase().startsWith('zh') ? 'zh-Hant' : 'en'
const isReaderHome = Boolean(channel?.isReaderHome)
const currentChannelTitle = String(channel?.title || '')
const currentSeoTitle = String(seo?.title || '')

const GOOGLE_SEARCH_SITE = getEnv(import.meta.env, Astro, 'GOOGLE_SEARCH_SITE')
const searchAction = GOOGLE_SEARCH_SITE ? 'https://www.google.com/search' : '/search/result'

const TAGS = getEnv(import.meta.env, Astro, 'TAGS')
const tags = TAGS ? TAGS.split(',').filter(Boolean) : []

const LINKS = getEnv(import.meta.env, Astro, 'LINKS')
const links = (LINKS || '')
  .split(';')
  .filter(Boolean)
  .map((link) => {
    const [title, href] = link.split(',')
    return { title, href }
  })

const navs = (getEnv(import.meta.env, Astro, 'NAVS') || '')
  .split(';')
  .filter(Boolean)
  .map((link) => {
    const [title, href] = link.split(',')
    return { title, href }
  })
---

<!doctype html>
<html lang={initialLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#126b57" />
    <meta name="application-name" content={brand} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={assetUrl('/favicon-32x32.png')} />
    <link rel="shortcut icon" href={assetUrl('/favicon.ico')} />
    <link rel="icon" type="image/x-icon" href={assetUrl('/favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={assetUrl('/apple-touch-icon.png')} />
    <link rel="manifest" href={assetUrl('/site.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={`${RSS_PREFIX}${channel?.title}`} href={RSS_URL} />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <meta name="technical-provider" content="david888.com" />
    <meta name="webmcp" content="enabled" />
    <style is:inline>
      @view-transition {
        navigation: auto; /* enabled */
      }
    </style>
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand} 公開頻道閱讀器品牌圖`} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${twitterHandle}`} />
    <meta name="twitter:creator" content={`@${twitterHandle}`} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${brand} 公開頻道閱讀器品牌圖`} />
    <script type="application/ld+json" is:inline set:html={structuredData}></script>
    {breadcrumbStructuredData && <script type="application/ld+json" is:inline set:html={breadcrumbStructuredData}></script>}
    {
      GA_MEASUREMENT_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
          <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID);
          </script>
        </>
      )
    }
    <Fragment set:html={getEnv(import.meta.env, Astro, 'HEADER_INJECT')} />
  </head>

  <body>
    <div id="wrapper">
      <!-- Slot for Full Width Header -->
      <slot name="header" />
      
      <!-- Language Preference Banner -->
      <aside id="lang-prompt-banner" class="lang-prompt-banner" style="display: none;" aria-label="語言偏好提示">
        <div class="lang-prompt-inner">
          <div class="lang-prompt-content">
            <span class="lang-prompt-icon" aria-hidden="true">🌐</span>
            <div class="lang-prompt-text-group">
              <p id="lang-prompt-message" class="lang-prompt-text"></p>
              <p id="lang-prompt-sub" class="lang-prompt-sub"></p>
            </div>
          </div>
          <div class="lang-prompt-actions">
            <button type="button" id="lang-prompt-keep" class="lang-prompt-btn lang-prompt-btn-primary"></button>
            <button type="button" id="lang-prompt-detected" class="lang-prompt-btn lang-prompt-btn-secondary"></button>
            <button type="button" id="lang-prompt-close" class="lang-prompt-close-btn" aria-label="關閉提示" title="關閉">✕</button>
          </div>
        </div>
      </aside>
      
      <div id="container">
        <div id="main-container">
          <slot />
        </div>
        <div id="aside-container">
          <slot name="aside">
            
            <input class="search-icon" name="icon" type="checkbox" aria-label="開啟搜尋" data-i18n-aria-label="searchToggle" />
            <form class="search-form" action={searchAction} method="get" toolname="search-articles" tooldescription="搜尋 Telegram 頻道的文章與標籤內容">
              {GOOGLE_SEARCH_SITE ? <input type="hidden" name="as_sitesearch" value={GOOGLE_SEARCH_SITE} /> : null}
              <label class="visually-hidden" for="site-search" data-i18n="searchLabel">搜尋網站內容</label>
              <input id="site-search" type="search" name="q" placeholder="搜尋文章與標籤" data-i18n-placeholder="searchPlaceholder" />
            </form>

            {
              getEnv(import.meta.env, Astro, 'ANYCHANNEL') === 'true' ? (
                Astro.url.pathname !== '/' && (
                  <a href="/" class="aside-switch" data-i18n="switchChannel">換一個頻道</a>
                )
              ) : (
                <a href={getEnv(import.meta.env, Astro, 'READER_URL') || 'https://telegram.david888.com/'} target="_blank" rel="noopener" class="aside-switch reader-switch">
                  888 頻道瀏覽器 →
                </a>
              )
            }

            {tags.length > 0 && (
              <div class="sidebar-card sidebar-tags">
                <h3 class="sidebar-card-title" data-i18n="tags">標籤分類</h3>
                <div class="tag-cloud">
                  {tags.map((tag) => (
                    <a href={`/search/${encodeURIComponent(tag)}`} class="tag-chip">#{tag}</a>
                  ))}
                </div>
              </div>
            )}

            <RandomRecommendation currentHandle={channel?.handle} />

            <PopularChannels currentHandle={channel?.handle} />

            {links.length > 0 && (
              <div class="sidebar-card sidebar-links">
                <h3 class="sidebar-card-title" data-i18n="links">相關連結</h3>
                <ul class="sidebar-links-list">
                  {links.map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener" class="sidebar-link-item">
                        <span>{link.title}</span>
                        <span class="sidebar-link-arrow">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {
              getEnv(import.meta.env, Astro, 'SIDEBAR_INJECT') && (
                <div class="sidebar-inject" set:html={getEnv(import.meta.env, Astro, 'SIDEBAR_INJECT')} />
              )
            }
          
          </slot>
        </div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-brand">
          <span class="footer-kicker" data-i18n="readerKicker">公開 Telegram 閱讀器</span>
          <span class="footer-title" data-i18n="brand">{brand}</span>
          <a href="https://david888.com" target="_blank" rel="noopener" class="footer-credit" data-i18n="technologyBy">技術提供 david888.com</a>
        </div>

        <nav class="footer-nav" aria-label="網站導覽">
          <a href={SITE_URL} class={`footer-link ${Astro.url.pathname === '/' ? 'current' : ''}`} data-i18n="home">首頁</a>
          {tags.length > 0 && <a href={`${SITE_URL}tags`} class={`footer-link ${Astro.url.pathname === '/tags' ? 'current' : ''}`} data-i18n="tags">標籤</a>}
          {links.length > 0 && <a href={`${SITE_URL}links`} class={`footer-link ${Astro.url.pathname === '/links' ? 'current' : ''}`} data-i18n="links">連結</a>}
        </nav>

        <div class="footer-actions">
          {RSS_URL && <a href={RSS_URL} target="_blank" rel="alternate" class="footer-link" data-i18n="rss">RSS</a>}
          <span data-i18n="publicReader">公開內容閱讀工具</span>
          <div class="language-switcher" role="group" aria-label="介面語言" data-i18n-aria-label="languageLabel">
            <span class="visually-hidden" data-i18n="languageLabel">介面語言</span>
            <button type="button" data-language="zh-Hant" aria-pressed="true">繁體中文</button>
            <span aria-hidden="true">|</span>
            <button type="button" data-language="en" aria-pressed="false">English</button>
          </div>
        </div>
      </div>
    </footer>
    <script define:vars={{ uiTranslations, initialLanguage, isReaderHome, currentChannelTitle, currentSeoTitle }}>
      const storageKey = 'telegram-reader-language'
      const decisionKey = 'telegram-reader-lang-decision'
      const dismissKey = 'telegram-lang-prompt-dismissed'
      const supportedLanguages = ['zh-Hant', 'en']
      let activeLanguage = initialLanguage

      const detectBrowserLanguage = () => {
        try {
          const navLangs = Array.isArray(navigator.languages) && navigator.languages.length
            ? navigator.languages
            : [navigator.language || navigator.userLanguage || '']
          for (const raw of navLangs) {
            const l = String(raw || '').toLowerCase().trim()
            if (!l) continue
            if (l.startsWith('zh')) return 'zh-Hant'
            if (l.startsWith('en')) return 'en'
          }
          if (navLangs.length > 0 && navLangs[0]) {
            const first = String(navLangs[0]).toLowerCase().trim()
            if (first.startsWith('zh')) return 'zh-Hant'
            return 'en'
          }
        } catch {
          // fallback
        }
        return initialLanguage || 'zh-Hant'
      }

      const banner = document.getElementById('lang-prompt-banner')
      const bannerMsg = document.getElementById('lang-prompt-message')
      const bannerSub = document.getElementById('lang-prompt-sub')
      const bannerKeepBtn = document.getElementById('lang-prompt-keep')
      const bannerDetectedBtn = document.getElementById('lang-prompt-detected')
      const bannerCloseBtn = document.getElementById('lang-prompt-close')

      const hidePrompt = () => {
        if (banner) banner.style.display = 'none'
      }

      const showPrompt = (detected, stored) => {
        if (!banner || !bannerMsg || !bannerKeepBtn || !bannerDetectedBtn) return

        const isDetectedZh = detected === 'zh-Hant'
        const isStoredZh = stored === 'zh-Hant'

        const storedLabelZh = isStoredZh ? '繁體中文' : '英文'
        const detectedLabelZh = isDetectedZh ? '繁體中文' : '英文'
        const storedLabelEn = isStoredZh ? 'Traditional Chinese' : 'English'
        const detectedLabelEn = isDetectedZh ? 'Traditional Chinese' : 'English'

        if (isDetectedZh) {
          bannerMsg.textContent = `偵測到您的瀏覽器語系為繁體中文，您先前曾設定為「${storedLabelZh}」。是否保留先前設定？`
          if (bannerSub) bannerSub.textContent = `Browser language detected: Traditional Chinese (previously selected: ${storedLabelEn}).`
          bannerKeepBtn.textContent = `保留「${storedLabelZh}」`
          bannerDetectedBtn.textContent = `以偵測為主 (${detectedLabelZh})`
        } else {
          bannerMsg.textContent = `偵測到您的瀏覽器語系為英文（EN），您先前曾設定為「${storedLabelZh}」。是否保留先前設定？`
          if (bannerSub) bannerSub.textContent = `Browser language detected: English (previously selected: ${storedLabelEn}). Keep previous setting?`
          bannerKeepBtn.textContent = `保留「${storedLabelZh}」`
          bannerDetectedBtn.textContent = `以偵測為主 (${detectedLabelEn})`
        }

        bannerKeepBtn.onclick = () => {
          applyLanguage(stored, true)
          try {
            window.localStorage.setItem(decisionKey, 'keep-' + stored)
            window.sessionStorage.setItem(dismissKey, '1')
          } catch {}
          hidePrompt()
        }

        bannerDetectedBtn.onclick = () => {
          applyLanguage(detected, true)
          try {
            window.localStorage.setItem(storageKey, detected)
            window.localStorage.removeItem(decisionKey)
            window.sessionStorage.setItem(dismissKey, '1')
          } catch {}
          hidePrompt()
        }

        if (bannerCloseBtn) {
          bannerCloseBtn.onclick = () => {
            try {
              window.sessionStorage.setItem(dismissKey, '1')
            } catch {}
            hidePrompt()
          }
        }

        banner.style.display = 'block'
      }

      const applyLanguage = (language, saveToStorage = false) => {
        const selectedLanguage = supportedLanguages.includes(language) ? language : initialLanguage
        const dictionary = uiTranslations[selectedLanguage]

        activeLanguage = selectedLanguage
        document.documentElement.lang = selectedLanguage
        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const value = dictionary[element.dataset.i18n]
          if (value !== undefined) {
            element.textContent = value.replace('{count}', element.dataset.i18nCount || '')
          }
        })
        document.querySelectorAll('[data-i18n-placeholder]').forEach((element) => {
          const value = dictionary[element.dataset.i18nPlaceholder]
          if (value !== undefined) element.setAttribute('placeholder', value)
        })
        document.querySelectorAll('[data-i18n-title]').forEach((element) => {
          const value = dictionary[element.dataset.i18nTitle]
          if (value !== undefined) element.setAttribute('title', value.replace('{count}', element.dataset.i18nCount || ''))
        })
        document.querySelectorAll('[data-i18n-aria-label]').forEach((element) => {
          const value = dictionary[element.dataset.i18nAriaLabel]
          if (value !== undefined) element.setAttribute('aria-label', value)
        })
        document.querySelectorAll('[data-i18n-weekday]').forEach((element) => {
          const value = dictionary.calendarWeekdays?.[Number(element.dataset.i18nWeekday)]
          if (value !== undefined) element.textContent = value
        })
        document.querySelectorAll('[data-i18n-month]').forEach((element) => {
          const [year, month] = element.dataset.i18nMonth.split('-').map(Number)
          element.textContent = selectedLanguage === 'en'
            ? new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long' }).format(new Date(Date.UTC(year, month - 1, 1)))
            : `${year}年${month}月`
        })
        document.querySelectorAll('[data-i18n-alt]').forEach((element) => {
          const value = dictionary[element.dataset.i18nAlt]
          if (value !== undefined) element.setAttribute('alt', value)
        })
        document.querySelectorAll('[data-language]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.language === selectedLanguage))
        })

        if (isReaderHome) {
          document.title = dictionary.homePageTitle || (selectedLanguage === 'en' ? '888 Telegram Channel Browser | Public Channel & Post Reader' : '888 Telegram 頻道瀏覽器｜公開頻道與文章閱讀')
        } else if (currentSeoTitle && ['Tags', 'Links'].includes(currentSeoTitle)) {
          const transSeoTitle = currentSeoTitle === 'Tags' ? dictionary.tags : dictionary.links
          document.title = `${transSeoTitle}｜${dictionary.brand}`
        } else if (currentChannelTitle) {
          document.title = selectedLanguage === 'en'
            ? `${currentChannelTitle} | ${dictionary.channelReaderSuffix || 'Public Telegram Channel Reader'}`
            : `${currentChannelTitle}｜${dictionary.channelReaderSuffix || 'Telegram 公開頻道閱讀器'}`
        }

        if (saveToStorage) {
          try {
            window.localStorage.setItem(storageKey, selectedLanguage)
          } catch {
            // Private browsing may disable localStorage; the toggle still works for this page.
          }
        }
      }

      const rawStored = (() => {
        try {
          return window.localStorage.getItem(storageKey)
        } catch {
          return null
        }
      })()
      const storedLanguage = supportedLanguages.includes(rawStored) ? rawStored : null

      const isDismissed = (() => {
        try {
          return window.sessionStorage.getItem(dismissKey) === '1'
        } catch {
          return false
        }
      })()

      const savedDecision = (() => {
        try {
          return window.localStorage.getItem(decisionKey)
        } catch {
          return null
        }
      })()

      const detectedLanguage = detectBrowserLanguage()

      document.querySelectorAll('[data-language]').forEach((button) => {
        button.addEventListener('click', () => {
          applyLanguage(button.dataset.language, true)
          try {
            window.localStorage.removeItem(decisionKey)
            window.sessionStorage.setItem(dismissKey, '1')
          } catch {}
          hidePrompt()
        })
      })
      window.addEventListener('telegram-language-change', () => applyLanguage(activeLanguage, false))

      if (storedLanguage && storedLanguage !== detectedLanguage) {
        if (savedDecision === 'keep-' + storedLanguage) {
          applyLanguage(storedLanguage, false)
        } else if (!isDismissed) {
          applyLanguage(detectedLanguage, false)
          showPrompt(detectedLanguage, storedLanguage)
        } else {
          applyLanguage(detectedLanguage, false)
        }
      } else if (storedLanguage && storedLanguage === detectedLanguage) {
        applyLanguage(storedLanguage, false)
      } else {
        applyLanguage(detectedLanguage, false)
      }
    </script>
    <script src="../scripts/webmcp.js"></script>
    <a href="#wrapper" id="back-to-top" aria-label="Back to top">
      <img {...backToTopIcon} alt="Back to Top" />
    </a>
    <style>
      .lang-prompt-banner {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        padding: 12px 20px 0 20px;
        box-sizing: border-box;
      }

      .lang-prompt-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 16px;
        border-radius: 10px;
        background: #f4f0ff;
        border: 1px solid #d4ccf7;
        color: #2b1d4a;
        box-shadow: 0 2px 8px rgba(112, 56, 232, 0.08);
        font-size: 0.875rem;
      }

      .lang-prompt-content {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        flex: 1;
      }

      .lang-prompt-icon {
        font-size: 1.25rem;
        flex-shrink: 0;
      }

      .lang-prompt-text-group {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }

      .lang-prompt-text {
        margin: 0;
        font-weight: 600;
        line-height: 1.4;
      }

      .lang-prompt-sub {
        margin: 0;
        font-size: 0.78rem;
        opacity: 0.75;
        line-height: 1.35;
      }

      .lang-prompt-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
      }

      .lang-prompt-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 12px;
        min-height: 30px;
        border-radius: 6px;
        font-family: var(--font-cjk);
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.18s ease;
        white-space: nowrap;
      }

      .lang-prompt-btn-primary {
        background: #7038e8;
