---
import List from '../components/list.astro'
import ChannelSearchForm from '../components/channel-search-form.astro'
import { getChannelInfo } from '../lib/telegram'
import { normalizeTelegramTarget } from '../lib/telegram/normalize'
import { getEnv } from '../lib/env'
import { Info } from 'lucide-astro'

const ANYCHANNEL = getEnv(import.meta.env, Astro, 'ANYCHANNEL') === 'true'
const turnstileEnabled = Boolean(Astro.locals.TURNSTILE_ENABLED && Astro.locals.TURNSTILE_SITE_KEY)

// 若表單提交（或網址帶有 ?channel=），使用者未輸入時預設導向 oliservice
if (ANYCHANNEL && Astro.url.searchParams.has('channel')) {
  const queryVal = (Astro.url.searchParams.get('channel') || '').trim()
  const target = normalizeTelegramTarget(queryVal || 'oliservice')
  if (target.ok) {
    return Astro.redirect(`/${target.handle}/`)
  }
}

const channel = ANYCHANNEL
  ? { handle: '', title: '888 Telegram 頻道瀏覽器', description: '輸入公開 Telegram 頻道或群組連結', posts: [], isReaderHome: true }
  : await getChannelInfo(Astro)
---

{
  ANYCHANNEL ? (
    <List channel={channel} after={false} showCalendar={false}>
      <section class="reader-hero" aria-labelledby="reader-title">
        <h1 id="reader-title" data-i18n="homepageHeading">把頻道內容，讀成清楚的時間線</h1>
        <p class="reader-lede" data-i18n="homepageLead">輸入公開頻道的 username 或連結，直接查看貼文、圖片與日期分組。</p>

        <ChannelSearchForm idPrefix="channel" anyChannel={true} turnstileEnabled={turnstileEnabled} redirectMode="direct" />

        <p class="reader-note">
          <Info size={18} class="reader-note-icon" aria-hidden="true" />
          <span data-i18n="publicNote">公開頻道可顯示貼文；私人、邀請連結與沒有公開預覽的群組會顯示支援狀態。</span>
        </p>
      </section>

      <section class="reader-points" aria-label="使用方式" data-i18n-aria-label="usage">
        <div class="reader-point">
          <span class="step-number">01</span>
          <div><strong data-i18n="stepInput">輸入</strong><span data-i18n="stepInputHelp">貼上 Telegram username 或連結</span></div>
        </div>
        <div class="reader-point">
          <span class="step-number">02</span>
          <div><strong data-i18n="stepIdentify">辨識</strong><span data-i18n="stepIdentifyHelp">先確認頻道身份與公開狀態</span></div>
        </div>
        <div class="reader-point">
          <span class="step-number">03</span>
          <div><strong data-i18n="stepRead">閱讀</strong><span data-i18n="stepReadHelp">沿日期分組回看文章與媒體</span></div>
        </div>
      </section>
    </List>
  ) : (
    <List channel={channel} after={false} />
  )
}

<style>
  .reader-hero {
    padding: clamp(28px, 4vw, 44px) clamp(20px, 3.5vw, 36px);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    box-shadow: var(--shadows);
  }

  .reader-hero h1 {
    margin: 0;
    color: var(--deep-blue);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .reader-lede {
    max-width: 54ch;
    margin: 16px 0 28px;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .reader-note {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 28px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--card-border-subtle);
    color: var(--text-muted);
    font-size: var(--text-meta);
    line-height: 1.5;
  }

  .reader-note-icon {
    flex: 0 0 auto;
    color: var(--deep-blue);
  }

  /* 3-Step feature guide matching 2md.aiurl.tw cards */
  .reader-points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 24px;
  }

  .reader-point {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 18px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    box-shadow: var(--card-shadow-sm);
  }

  .step-number {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: var(--deep-blue);
    background: var(--canvas);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .reader-point div {
    display: grid;
    gap: 3px;
  }

  .reader-point strong {
    color: var(--deep-blue);
    font-size: var(--text-ui);
    font-weight: 700;
  }

  .reader-point span:last-child {
    color: var(--text-muted);
    font-size: var(--text-meta);
    line-height: 1.45;
  }

  @media screen and (max-width: 640px) {
    .reader-points {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
