---
import List from '../components/list.astro'
import { getChannelInfo } from '../lib/telegram'
import { getEnv } from '../lib/env'
const ANYCHANNEL = getEnv(import.meta.env, Astro, 'ANYCHANNEL') === 'true'
console.log(`[DEBUG] ANYCHANNEL lookup: ${getEnv(import.meta.env, Astro, 'ANYCHANNEL')} (Is True: ${ANYCHANNEL})`)
const channel = ANYCHANNEL
  ? { handle: '', title: '888 Telegram 頻道瀏覽器', description: '輸入公開 Telegram 頻道或群組連結', posts: [], isReaderHome: true }
  : await getChannelInfo(Astro)
---

{
  ANYCHANNEL ? (
    <List channel={channel} after={false} showCalendar={false}>
      <section class="reader-hero" aria-labelledby="reader-title">
        <p class="eyebrow" data-i18n="readerKicker">公開 Telegram 閱讀器</p>
        <h1 id="reader-title" data-i18n="homepageHeading">把頻道內容，讀成清楚的時間線</h1>
        <p class="reader-lede" data-i18n="homepageLead">輸入公開頻道的 username 或連結，直接查看貼文、圖片與日期分組。</p>

        <form action="/" method="get" class="channel-form">
          <label class="channel-label" for="channel-input" data-i18n="channelInputLabel">輸入頻道或群組</label>
          <div class="channel-form-row">
            <input id="channel-input" type="text" name="channel" placeholder="@oliservice、oliservice 或 https://t.me/oliservice" data-i18n-placeholder="channelInputPlaceholder" autocomplete="off" spellcheck="false" required class="channel-input" aria-describedby="channel-help channel-error" />
            <button type="submit" class="channel-submit" data-i18n="startReading">開始閱讀</button>
          </div>
          <p id="channel-help" class="channel-help" data-i18n="supportedInput">支援 @username、裸 username，或公開 t.me 連結。</p>
          <p id="channel-error" class="channel-error" role="alert"></p>
        </form>

        <p class="reader-note"><span class="reader-note-mark" aria-hidden="true">i</span> <span data-i18n="publicNote">公開頻道可顯示貼文；私人、邀請連結與沒有公開預覽的群組會顯示支援狀態。</span></p>
      </section>

      <section class="reader-points" aria-label="使用方式" data-i18n-aria-label="usage">
        <div class="reader-point">
          <span class="step-number">01</span>
          <div><strong data-i18n="stepInput">輸入</strong><span data-i18n="stepInputHelp">貼上 Telegram username 或連結</span></div>
        </div>
        <div class="reader-point">
          <span class="step-number">02</span>
          <div><strong data-i18n="stepIdentify">辨識</strong><span data-i18n="stepIdentifyHelp">先確認頻道身份與公開狀態</span></div>
        </div>
        <div class="reader-point">
          <span class="step-number">03</span>
          <div><strong data-i18n="stepRead">閱讀</strong><span data-i18n="stepReadHelp">沿日期分組回看文章與媒體</span></div>
        </div>
      </section>
    </List>
  ) : (
    <List channel={channel} after={false} />
  )
}

<style>
  .reader-hero {
    padding: clamp(32px, 6vw, 72px) clamp(22px, 5vw, 64px);
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--box-border-radius);
    box-shadow: var(--shadows);
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--accent-color);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  .reader-hero h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--foreground-color);
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.35;
    letter-spacing: -0.04em;
  }

  .reader-lede {
    max-width: 48ch;
    margin: 24px 0 40px;
    color: var(--secondary-color);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .channel-form {
    max-width: 780px;
  }

  .channel-label {
    display: block;
    margin-bottom: 12px;
    color: var(--foreground-color);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .channel-form-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
  }

  .channel-input {
    min-height: 56px;
    min-width: 0;
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--box-border-radius);
    background: var(--background-color);
    color: var(--foreground-color);
    font-family: var(--font-cjk);
    font-size: 1rem;
  }

  .channel-input::placeholder {
    color: var(--secondary-color);
    opacity: 0.85;
  }

  .channel-input[aria-invalid='true'] {
    border-color: var(--highlight-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--highlight-color) 18%, transparent);
  }

  .channel-submit {
    min-height: 56px;
    padding: 12px 24px;
    border: 1px solid var(--accent-color);
    border-radius: var(--box-border-radius);
    background: var(--accent-color);
    color: #fffdf8;
    cursor: pointer;
    font-family: var(--font-cjk);
    font-size: 1.125rem;
    font-weight: 700;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .channel-submit:hover {
    background: var(--foreground-color);
  }

  .channel-submit:active {
    transform: translateY(1px);
  }

  .channel-help,
  .channel-error {
    margin: 12px 0 0;
    color: var(--secondary-color);
    font-size: 1rem;
    line-height: 1.6;
  }

  .channel-error:empty {
    display: none;
  }

  .channel-error {
    color: var(--highlight-color);
  }

  .reader-note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    max-width: 62ch;
    margin: 32px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
    color: var(--secondary-color);
    font-size: 1rem;
    line-height: 1.7;
  }

  .reader-note-mark {
    display: inline-grid;
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid var(--accent-color);
    border-radius: 50%;
    color: var(--accent-color);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .reader-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 28px;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .reader-point {
    display: flex;
    gap: 14px;
    padding: 20px 18px;
    border-right: 1px solid var(--border-color);
  }

  .reader-point:last-child {
    border-right: 0;
  }

  .step-number {
    color: var(--accent-color);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.8;
  }

  .reader-point div {
    display: grid;
    gap: 4px;
  }

  .reader-point strong {
    color: var(--foreground-color);
    font-size: 1rem;
  }

  .reader-point span:last-child {
    color: var(--secondary-color);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  @media screen and (max-width: 640px) {
    .reader-points {
      grid-template-columns: 1fr;
    }

    .popular-channels {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 22px 18px;
    }

    .reader-point {
      border-right: 0;
      border-bottom: 1px solid var(--border-color);
    }

    .reader-point:last-child {
      border-bottom: 0;
    }
  }
</style>

<script>
  import { normalizeTelegramTarget } from '../lib/telegram/normalize'

  const form = document.querySelector('.channel-form')
  const input = document.querySelector('#channel-input')
  const error = document.querySelector('#channel-error')

  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    const target = normalizeTelegramTarget(input?.value)

    if (!target.ok) {
      if (input) input.setAttribute('aria-invalid', 'true')
      if (error) {
        error.dataset.i18n = target.code === 'invite' ? 'errorInvite' : target.code === 'private' ? 'errorPrivate' : 'errorInvalid'
        error.textContent = target.code === 'invite'
          ? '邀請連結不能讀取公開歷史，請改輸入公開頻道 username。'
          : target.code === 'private'
            ? '私人連結不能讀取公開歷史，請改輸入公開頻道 username。'
            : '請輸入 @username、username，或完整的 t.me 公開連結。'
        window.dispatchEvent(new CustomEvent('telegram-language-change'))
      }
      return
    }

    if (input) input.setAttribute('aria-invalid', 'false')
    if (error) error.textContent = ''
    window.location.assign(`/${target.handle}/`)
  })
</script>
