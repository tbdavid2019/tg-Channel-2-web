---
import List from '../components/list.astro'
import { getChannelInfo } from '../lib/telegram'
import { normalizeTelegramTarget } from '../lib/telegram/normalize'
import { getEnv } from '../lib/env'
const ANYCHANNEL = getEnv(import.meta.env, Astro, 'ANYCHANNEL') === 'true'
const turnstileEnabled = Boolean(Astro.locals.TURNSTILE_ENABLED && Astro.locals.TURNSTILE_SITE_KEY)
const turnstileSiteKey = Astro.locals.TURNSTILE_SITE_KEY

// 若表單提交（或網址帶有 ?channel=），使用者未輸入時預設導向 oliservice
if (ANYCHANNEL && Astro.url.searchParams.has('channel')) {
  const queryVal = (Astro.url.searchParams.get('channel') || '').trim()
  const target = normalizeTelegramTarget(queryVal || 'oliservice')
  if (target.ok) {
    return Astro.redirect(`/${target.handle}/`)
  }
}

const channel = ANYCHANNEL
  ? { handle: '', title: '888 Telegram 頻道瀏覽器', description: '輸入公開 Telegram 頻道或群組連結', posts: [], isReaderHome: true }
  : await getChannelInfo(Astro)
---

{
  ANYCHANNEL ? (
    <List channel={channel} after={false} showCalendar={false}>
      <section class="reader-hero" aria-labelledby="reader-title">
        <p class="eyebrow" data-i18n="readerKicker">公開 Telegram 閱讀器</p>
        <h1 id="reader-title" data-i18n="homepageHeading">把頻道內容，讀成清楚的時間線</h1>
        <p class="reader-lede" data-i18n="homepageLead">輸入公開頻道的 username 或連結，直接查看貼文、圖片與日期分組。</p>

        <form action="/" method="get" class="channel-form" toolname="navigate-channel" tooldescription="輸入 Telegram 頻道或群組 username 進行公開閱讀" data-turnstile-action={turnstileEnabled ? 'channel_search' : undefined}>
          <label class="channel-label" for="channel-input" data-i18n="channelInputLabel">輸入要閱讀的頻道或群組</label>
          <div class="channel-form-row">
            <input id="channel-input" type="text" name="channel" placeholder="@oliservice、oliservice 或 https://t.me/oliservice" data-i18n-placeholder="channelInputPlaceholder" autocomplete="off" spellcheck="false" class="channel-input" aria-describedby="channel-help channel-error" />
            <button type="submit" class="channel-submit" data-i18n="startReading">開始閱讀</button>
          </div>
          <p id="channel-help" class="channel-help" data-i18n="supportedInput">支援 @username、裸 username，或公開 t.me 連結。</p>
          <p id="channel-error" class="channel-error" role="alert"></p>
        </form>

        <p class="reader-note"><span class="reader-note-mark" aria-hidden="true">i</span> <span data-i18n="publicNote">公開頻道可顯示貼文；私人、邀請連結與沒有公開預覽的群組會顯示支援狀態。</span></p>
      </section>

      <section class="reader-points" aria-label="使用方式" data-i18n-aria-label="usage">
        <div class="reader-point">
          <span class="step-number">01</span>
          <div><strong data-i18n="stepInput">輸入</strong><span data-i18n="stepInputHelp">貼上 Telegram username 或連結</span></div>
        </div>
        <div class="reader-point">
          <span class="step-number">02</span>
          <div><strong data-i18n="stepIdentify">辨識</strong><span data-i18n="stepIdentifyHelp">先確認頻道身份與公開狀態</span></div>
        </div>
        <div class="reader-point">
          <span class="step-number">03</span>
          <div><strong data-i18n="stepRead">閱讀</strong><span data-i18n="stepReadHelp">沿日期分組回看文章與媒體</span></div>
        </div>
      </section>
    </List>
  ) : (
    <List channel={channel} after={false} />
  )
}

<style>
  .reader-hero {
    padding: clamp(28px, 4vw, 44px) clamp(20px, 3.5vw, 36px);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    box-shadow: var(--shadows);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    background: var(--canvas);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    color: var(--deep-blue);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: 0.04em;
  }

  .reader-hero h1 {
    margin: 0;
    color: var(--deep-blue);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4.5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .reader-lede {
    max-width: 54ch;
    margin: 16px 0 28px;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .channel-form {
    max-width: 100%;
  }

  .channel-label {
    display: block;
    margin-bottom: 10px;
    color: var(--deep-blue);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .channel-form-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
  }

  .channel-input {
    min-height: 52px;
    min-width: 0;
    padding: 12px 18px;
    border: 1.5px solid var(--input-border);
    border-radius: var(--radius-sm);
    background: var(--input-bg);
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 1rem;
    transition: all 0.15s ease;
  }

  .channel-input::placeholder {
    color: var(--text-muted);
    opacity: 0.75;
  }

  .channel-input:focus {
    outline: 3px solid var(--primary);
    outline-offset: 1px;
    border-color: var(--deep-blue);
  }

  .channel-input[aria-invalid='true'] {
    border-color: var(--clay);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--clay) 20%, transparent);
  }

  .channel-submit {
    min-height: 52px;
    padding: 12px 28px;
    border: 1.5px solid var(--input-border);
    border-radius: var(--radius-sm);
    background: var(--primary);
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 700;
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .channel-submit:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 176, 16, 0.35);
  }

  .channel-submit:active {
    transform: translateY(1px);
  }

  .channel-help,
  .channel-error {
    margin: 10px 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .channel-help {
    color: var(--text-muted);
  }

  .channel-error:empty {
    display: none;
  }

  .channel-error {
    color: var(--clay);
    font-weight: 600;
  }

  .reader-note {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 28px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--card-border-subtle);
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .reader-note-mark {
    display: inline-grid;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    place-items: center;
    border: 1.5px solid var(--deep-blue);
    border-radius: 50%;
    color: var(--deep-blue);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  /* 3-Step feature guide matching 2md.aiurl.tw cards */
  .reader-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 24px;
  }

  .reader-point {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 18px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    box-shadow: 0 2px 8px rgba(43, 37, 26, 0.04);
  }

  .step-number {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--deep-blue);
    background: var(--canvas);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .reader-point div {
    display: grid;
    gap: 3px;
  }

  .reader-point strong {
    color: var(--deep-blue);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .reader-point span:last-child {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  @media screen and (max-width: 640px) {
    .channel-form-row {
      grid-template-columns: 1fr;
    }

    .channel-submit {
      width: 100%;
    }

    .reader-points {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>

<script>
  import { normalizeTelegramTarget } from '../lib/telegram/normalize'

  const form = document.querySelector('.channel-form')
  const input = document.querySelector('#channel-input')
  const error = document.querySelector('#channel-error')

  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    const rawVal = (input instanceof HTMLInputElement ? input.value : (input?.value || '')).trim()
    const targetVal = rawVal || 'oliservice'
    const target = normalizeTelegramTarget(targetVal)

    if (!target.ok) {
      if (input) input.setAttribute('aria-invalid', 'true')
      if (error) {
        error.dataset.i18n = target.code === 'invite' ? 'errorInvite' : target.code === 'private' ? 'errorPrivate' : 'errorInvalid'
        error.textContent = target.code === 'invite'
          ? '邀請連結不能讀取公開歷史，請改輸入公開頻道 username。'
          : target.code === 'private'
            ? '私人連結不能讀取公開歷史，請改輸入公開頻道 username。'
            : '請輸入 @username、username，或完整的 t.me 公開連結。'
        window.dispatchEvent(new CustomEvent('telegram-language-change'))
      }
      return
    }

    if (input) input.setAttribute('aria-invalid', 'false')
    if (error) error.textContent = ''
    window.location.assign(`/?channel=${encodeURIComponent(target.handle)}`)
  })
</script>
