---
import '../assets/item.css'
import 'prismjs/themes/prism.css'
import dayjs from '../lib/dayjs'
import { getEnv } from '../lib/env'
import { sanitizeContent } from '../lib/telegram/sanitize'
import { extractArticleSections, injectSectionAnchors, extractPostExcerpt } from '../lib/telegram/toc'
import { ShieldAlert, ShieldCheck, ChevronDown } from 'lucide-astro'

const locale = getEnv(import.meta.env, Astro, 'LOCALE')
const timezone = getEnv(import.meta.env, Astro, 'TIMEZONE')

locale && dayjs.locale(locale)

const rawSiteUrl = Astro.locals.SITE_URL || '/'
const SITE_URL = rawSiteUrl.replace(/^https?:\/\/[^/]+/i, '') || '/'
const { post, isItem } = Astro.props

const channel = getEnv(import.meta.env, Astro, 'CHANNEL')
const COMMENTS = getEnv(import.meta.env, Astro, 'COMMENTS')

const datetime = dayjs(post.datetime).tz(timezone)
const timeago = datetime.isBefore(dayjs().subtract(1, 'w')) ? datetime.format('HH:mm · ll · ddd') : datetime.fromNow()
const safeContent = post.content ? sanitizeContent(post.content) : ''

// 單篇文章模式下，智慧注入章節錨點
let finalContent = safeContent
if (isItem && safeContent.length > 0) {
  const sections = extractArticleSections(safeContent, {
    hasMedia: safeContent.includes('<img') || safeContent.includes('<video'),
    hasTags: post.tags && post.tags.length > 0,
    tagsCount: post.tags?.length || 0,
    hasComments: Boolean(COMMENTS),
    postId: post.id,
  })
  finalContent = injectSectionAnchors(safeContent, sections)
}

const adExcerpt = post.isAd ? extractPostExcerpt(post, 42) : ''
---

<article class={`item ${post.isAd ? 'is-ad-item' : ''}`} id={`post-${post.id}`} style={{ 'view-transition-name': `post-${post.id}` }}>
  <div class="time-box">
    <div class="dot"></div>
    <div class="time">
      <a href={`${SITE_URL}posts/${post.id}`} title={post.datetime} class="item-link">
        <time datetime={post.datetime} title={timeago}>{timeago}</time>
      </a>
    </div>
    {post.isAd && (
      <span class="ad-pill" title="此貼文經 AI 決策模型判定為推廣/廣告內容">
        <ShieldAlert size={12} class="ad-pill-icon" aria-hidden="true" />
        <span data-i18n="adBadge">推廣內容</span>
      </span>
    )}
  </div>

  {post.isAd && !isItem ? (
    <div class="ad-collapsed-card">
      <div class="ad-collapsed-header">
        <div class="ad-collapsed-meta">
          <ShieldCheck size={16} class="ad-collapsed-icon" aria-hidden="true" />
          <span class="ad-collapsed-badge" data-i18n="adFilteredTag">已自動過濾推廣內容</span>
        </div>
        <span class="ad-collapsed-excerpt">{adExcerpt}</span>
      </div>
      <button
        type="button"
        class="ad-expand-btn"
        data-toggle-target={`ad-body-${post.id}`}
        aria-expanded="false"
      >
        <span class="ad-expand-text" data-i18n="expandAd">展開查看</span>
        <ChevronDown size={14} class="ad-expand-icon" aria-hidden="true" />
      </button>
    </div>
    <div class="ad-collapsible-wrapper" id={`ad-body-${post.id}`} style="display: none;">
      {finalContent.length > 0 && <div class="text-box content" set:html={finalContent} />}
      {
        post.tags && post.tags.length > 0 && (
          <div class="tag-box" style={post.content.length === 0 ? 'padding-top: 30px;' : ''}>
            <div class="tag-icon" />
            {post.tags.map((tag) => (
              <a href={`/search/result?q=${encodeURIComponent(tag)}`} title={tag} class="tag">
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  ) : (
    <>
      {finalContent.length > 0 && <div class={`text-box content`} id={isItem ? 'post-content' : undefined} set:html={finalContent} />}
      {
        post.tags && post.tags.length > 0 && (
          <div class="tag-box" id={isItem ? 'post-tags' : undefined} style={post.content.length === 0 ? 'padding-top: 30px;' : ''}>
            <div class="tag-icon" />
            {post.tags.map((tag) => (
              <a href={`/search/result?q=${encodeURIComponent(tag)}`} title={tag} class="tag">
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </>
  )}

  {
    COMMENTS && isItem && (
      <div class="comments" id="post-comments">
        <script
          is:inline
          async
          src="https://telegram.org/js/telegram-widget.js"
          data-telegram-discussion={`${post.channel ?? channel}/${post.id}`}
          data-comments-limit="50"
          data-colorful="1"
          data-color="454545"
        />
      </div>
    )
  }
</article>

<script>
  function setupAdToggle() {
    // 綁定全域委派事件，防止動態插入或多個卡片事件遺失
    if (window.__adToggleInitialized) return
    window.__adToggleInitialized = true

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest('.ad-expand-btn') as HTMLButtonElement | null
      if (!btn) return

      const targetId = btn.getAttribute('data-toggle-target')
      if (!targetId) return
      const targetEl = document.getElementById(targetId)
      if (!targetEl) return

      const isHidden = targetEl.style.display === 'none'
      if (isHidden) {
        targetEl.style.display = 'block'
        btn.setAttribute('aria-expanded', 'true')
        btn.classList.add('is-expanded')
        const text = btn.querySelector('.ad-expand-text')
        if (text) text.textContent = '收合內容'
      } else {
        targetEl.style.display = 'none'
        btn.setAttribute('aria-expanded', 'false')
        btn.classList.remove('is-expanded')
        const text = btn.querySelector('.ad-expand-text')
        if (text) text.textContent = '展開查看'
      }
    })

    // 若直接從錨點進入（例如 #post-2762），自動展開該推廣內容以供檢視
    if (window.location.hash) {
      try {
        const target = document.querySelector(window.location.hash)
        if (target) {
          const btn = target.querySelector('.ad-expand-btn') as HTMLButtonElement | null
          if (btn && btn.getAttribute('aria-expanded') === 'false') {
            btn.click()
          }
        }
      } catch {}
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdToggle)
  } else {
    setupAdToggle()
  }
  document.addEventListener('astro:page-load', setupAdToggle)
</script>
