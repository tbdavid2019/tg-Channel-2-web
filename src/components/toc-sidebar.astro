---
import dayjs from '../lib/dayjs'
import { getEnv } from '../lib/env'
import { sanitizeContent } from '../lib/telegram/sanitize'
import {
  extractPostExcerpt,
  extractArticleSections,
  buildTimelineToc,
} from '../lib/telegram/toc'

const { channel, posts = [], isItem = false } = Astro.props

const tz = getEnv(import.meta.env, Astro, 'TIMEZONE') ?? 'UTC'
const isAnyChannel = getEnv(import.meta.env, Astro, 'ANYCHANNEL') === 'true'
const hasComments = Boolean(getEnv(import.meta.env, Astro, 'COMMENTS'))

const primaryPost = posts[0] || null
const primaryDatetime = primaryPost?.datetime ? dayjs(primaryPost.datetime).tz(tz) : null
const formattedDate = primaryDatetime ? primaryDatetime.format('YYYY-MM-DD HH:mm') : ''
const timeago = primaryDatetime
  ? primaryDatetime.isBefore(dayjs().subtract(1, 'w'))
    ? primaryDatetime.format('MM/DD')
    : primaryDatetime.fromNow()
  : ''

const channelTitle = channel?.title || (channel?.handle ? `@${channel.handle}` : 'Telegram 頻道')
const channelHandle = channel?.handle || ''
const channelUrl = channelHandle
  ? `https://t.me/${channelHandle}${isItem && primaryPost?.id ? `/${primaryPost.id}` : ''}`
  : '#'
const displayDomain = channelHandle ? `t.me/${channelHandle}` : 'telegram.david888.com'

const backUrl = isItem
  ? (channelHandle ? `/${channelHandle}/` : '/')
  : (isAnyChannel ? '/' : '#top')
const backLabel = isItem ? '返回頻道' : (isAnyChannel ? '所有頻道' : '回到頁首')
const backArrow = isItem || isAnyChannel ? '←' : '↑'

let tocItems = []

if (isItem && primaryPost) {
  const safeContent = primaryPost.content ? sanitizeContent(primaryPost.content) : ''
  const sections = extractArticleSections(safeContent, {
    hasMedia: Boolean(safeContent.includes('<img') || safeContent.includes('<video')),
    hasTags: Boolean(primaryPost.tags && primaryPost.tags.length > 0),
    tagsCount: primaryPost.tags?.length || 0,
    hasComments,
    postId: primaryPost.id,
  })

  const hasCustomHeadings = sections.some((s) => !s.isLandmark)

  if (hasCustomHeadings) {
    const excerpt = extractPostExcerpt(primaryPost, 26)
    tocItems.push({
      id: `toc-post-${primaryPost.id}`,
      targetId: `post-${primaryPost.id}`,
      title: excerpt,
      fullTitle: primaryPost.title || excerpt,
      level: 1,
    })

    for (const sec of sections) {
      tocItems.push({
        id: `toc-sec-${sec.id}`,
        targetId: sec.id,
        title: sec.title,
        fullTitle: sec.title,
        level: sec.level || 2,
      })
    }

    if (primaryPost.tags && primaryPost.tags.length > 0) {
      tocItems.push({
        id: 'toc-post-tags',
        targetId: 'post-tags',
        title: `標籤 (${primaryPost.tags.length})`,
        fullTitle: `標籤: #${primaryPost.tags.join(' #')}`,
        level: 3,
      })
    }

    if (hasComments) {
      tocItems.push({
        id: 'toc-post-comments',
        targetId: 'post-comments',
        title: '頻道留言',
        fullTitle: 'Telegram 頻道留言討論',
        level: 3,
      })
    }
  } else {
    tocItems = sections.map((sec) => ({
      id: `toc-${sec.id}`,
      targetId: sec.id,
      title: sec.title,
      fullTitle: sec.title,
      level: 2,
    }))
  }
} else {
  tocItems = buildTimelineToc(posts, tz)
}
---

<!-- Desktop Sticky TOC Sidebar (Matches 2md.aiurl.tw layout) -->
<nav class="toc-sidebar-container" aria-label="文章與目錄導覽">
  <div class="toc-sidebar-sticky">
    <!-- Top Back Link -->
    <div class="toc-back-wrapper">
      <a href={backUrl} class="toc-back-link">
        <span class="toc-back-arrow" aria-hidden="true">{backArrow}</span>
        <span class="toc-back-label" data-i18n={isItem ? 'backToChannel' : (isAnyChannel ? 'allChannels' : 'backToTop')}>
          {backLabel}
        </span>
      </a>
    </div>

    <hr class="toc-divider" />

    <!-- Source Section (來源) -->
    <div class="toc-section toc-source-section">
      <div class="toc-section-kicker" data-i18n="sourceLabel">來源</div>
      <div class="toc-source-card">
        <a
          href={channelUrl}
          target="_blank"
          rel="noopener"
          class="toc-source-title"
          title={`在 Telegram 開啟 ${channelTitle}`}
        >
          <span class="toc-source-name">{channelTitle}</span>
          <span class="toc-ext-icon" aria-hidden="true">↗</span>
        </a>
        <div class="toc-source-domain">{displayDomain}</div>
      </div>
    </div>

    <!-- Publish Time Section (發布時間 / 最新發文) -->
    {formattedDate && (
      <div class="toc-section toc-time-section">
        <div class="toc-section-kicker" data-i18n={isItem ? 'publishTimeLabel' : 'latestUpdateLabel'}>
          {isItem ? '發布時間' : '最新發文'}
        </div>
        <div class="toc-time-card">
          <div class="toc-time-exact">{formattedDate}</div>
          {timeago && <div class="toc-time-relative">{timeago}</div>}
        </div>
      </div>
    )}

    <hr class="toc-divider" />

    <!-- Table of Contents Section (本文目錄 / 本頁目錄) -->
    {tocItems.length > 0 && (
      <div class="toc-section toc-nav-section">
        <div class="toc-section-kicker" data-i18n={isItem ? 'articleTocLabel' : 'pageTocLabel'}>
          {isItem ? '本文目錄' : '本頁目錄'}
        </div>
        <div class="toc-links-list" role="list">
          {tocItems.map((item, idx) => (
            <a
              href={`#${item.targetId}`}
              class={`toc-link ${idx === 0 ? 'is-active' : ''} ${item.level === 3 ? 'is-level-sub' : ''} ${item.isAd ? 'is-ad' : ''}`}
              data-target={item.targetId}
              role="listitem"
              title={item.fullTitle}
            >
              <span class="toc-link-text">{item.title}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</nav>

<!-- Mobile / Tablet TOC Floating Trigger & Slide-out Sheet -->
{tocItems.length > 0 && (
  <div class="mobile-toc-root">
    <button
      type="button"
      class="mobile-toc-fab"
      id="mobile-toc-fab-btn"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-label="開啟文章目錄"
    >
      <span class="mobile-toc-fab-icon" aria-hidden="true">📑</span>
      <span class="mobile-toc-fab-text" data-i18n="mobileTocToggle">目錄</span>
      <span class="mobile-toc-fab-count">{tocItems.length}</span>
    </button>

    <div class="mobile-toc-backdrop" id="mobile-toc-backdrop" aria-hidden="true" style="display: none;"></div>

    <aside
      class="mobile-toc-sheet"
      id="mobile-toc-sheet"
      role="dialog"
      aria-modal="true"
      aria-label="文章目錄導覽"
      aria-hidden="true"
      style="display: none;"
    >
      <div class="mobile-toc-sheet-header">
        <div class="mobile-toc-sheet-title">
          <span class="mobile-toc-sheet-icon" aria-hidden="true">📑</span>
          <span data-i18n={isItem ? 'articleTocLabel' : 'pageTocLabel'}>
            {isItem ? '本文目錄' : '本頁目錄'}
          </span>
          <span class="mobile-toc-badge">{tocItems.length} 篇</span>
        </div>
        <button
          type="button"
          class="mobile-toc-close-btn"
          id="mobile-toc-close-btn"
          aria-label="關閉目錄"
        >
          ✕
        </button>
      </div>

      <div class="mobile-toc-sheet-body">
        <div class="mobile-toc-source-meta">
          <span class="mobile-toc-meta-label" data-i18n="sourceLabel">來源</span>
          <div class="mobile-toc-source-row">
            <span class="mobile-toc-channel-title">{channelTitle}</span>
            <span class="mobile-toc-channel-domain">{displayDomain}</span>
          </div>
        </div>

        <div class="mobile-toc-list" role="list">
          {tocItems.map((item, idx) => (
            <a
              href={`#${item.targetId}`}
              class={`mobile-toc-item ${idx === 0 ? 'is-active' : ''} ${item.isAd ? 'is-ad' : ''}`}
              data-target={item.targetId}
              role="listitem"
            >
              <span class="mobile-toc-num">{String(idx + 1).padStart(2, '0')}</span>
              <span class="mobile-toc-label">{item.fullTitle}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>
  </div>
)}

<script>
  // High-performance TOC Controller with Zero Scroll Loop and Protected Mobile Sheet
  function initToc() {
    // 清理舊的監聽器，確保 idempotent
    if (window.__tocScrollHandler) {
      window.removeEventListener('scroll', window.__tocScrollHandler);
      window.__tocScrollHandler = null;
    }
    if (window.__tocKeydownHandler) {
      document.removeEventListener('keydown', window.__tocKeydownHandler);
      window.__tocKeydownHandler = null;
    }

    // 1. 保證行動版懸浮按鈕與抽屜掛載在 document.body，不受任何父容器 overflow/display 限制
    const mobileRoots = document.querySelectorAll('.mobile-toc-root');
    if (mobileRoots.length > 0) {
      for (let i = 0; i < mobileRoots.length - 1; i++) {
        mobileRoots[i].remove();
      }
      const activeMobileRoot = mobileRoots[mobileRoots.length - 1];
      if (activeMobileRoot.parentElement && activeMobileRoot.parentElement !== document.body) {
        document.body.appendChild(activeMobileRoot);
      }
    }

    const desktopLinks = document.querySelectorAll('.toc-link[data-target]');
    const mobileLinks = document.querySelectorAll('.mobile-toc-item[data-target]');
    const allLinks = [...desktopLinks, ...mobileLinks];

    if (allLinks.length === 0) return;

    // 快取目錄對應的目標 DOM 元素，避免在每個 scroll frame 反覆 document.getElementById
    const targetElements = [];
    desktopLinks.forEach((l) => {
      const id = l.getAttribute('data-target');
      const el = id ? document.getElementById(id) : null;
      if (el) targetElements.push(el);
    });

    // Mobile sheet controls
    const fab = document.getElementById('mobile-toc-fab-btn');
    const sheet = document.getElementById('mobile-toc-sheet');
    const backdrop = document.getElementById('mobile-toc-backdrop');
    const closeBtn = document.getElementById('mobile-toc-close-btn');
    const sidebarContainer = document.querySelector('#toc-container');

    let closeTimer = null;

    function openMobileSheet() {
      if (!sheet || !backdrop || !fab) return;
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      backdrop.style.display = 'block';
      sheet.style.display = 'flex';
      void sheet.offsetHeight; // force reflow for smooth transform animation
      sheet.classList.add('is-open');
      backdrop.classList.add('is-open');
      sheet.setAttribute('aria-hidden', 'false');
      fab.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileSheet() {
      if (!sheet || !backdrop || !fab) return;
      sheet.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      sheet.setAttribute('aria-hidden', 'true');
      fab.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      closeTimer = setTimeout(() => {
        if (!sheet.classList.contains('is-open')) {
          sheet.style.display = 'none';
          backdrop.style.display = 'none';
        }
      }, 260);
    }

    if (fab) {
      fab.onclick = () => {
        const isOpen = sheet?.classList.contains('is-open');
        if (isOpen) closeMobileSheet();
        else openMobileSheet();
      };
    }

    if (closeBtn) closeBtn.onclick = closeMobileSheet;
    if (backdrop) backdrop.onclick = closeMobileSheet;

    window.__tocKeydownHandler = (e) => {
      if (e.key === 'Escape' && sheet?.classList.contains('is-open')) {
        closeMobileSheet();
      }
    };
    document.addEventListener('keydown', window.__tocKeydownHandler);

    // 活躍標記管理器：絕不調用 scrollIntoView()！
    // 僅在目錄側欄內部做 scrollTop 滾動，避免干擾使用者與 window
    function setActive(targetId) {
      if (!targetId) return;

      let activeDesktopLink = null;

      desktopLinks.forEach((link) => {
        if (link.getAttribute('data-target') === targetId) {
          link.classList.add('is-active');
          activeDesktopLink = link;
        } else {
          link.classList.remove('is-active');
        }
      });

      mobileLinks.forEach((link) => {
        if (link.getAttribute('data-target') === targetId) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });

      if (sidebarContainer && activeDesktopLink) {
        const linkTop = activeDesktopLink.offsetTop;
        const linkHeight = activeDesktopLink.offsetHeight;
        const cScrollTop = sidebarContainer.scrollTop;
        const cHeight = sidebarContainer.clientHeight;

        if (linkTop < cScrollTop) {
          sidebarContainer.scrollTop = Math.max(0, linkTop - 12);
        } else if (linkTop + linkHeight > cScrollTop + cHeight) {
          sidebarContainer.scrollTop = linkTop + linkHeight - cHeight + 12;
        }
      }
    }

    // 點擊目錄項目平滑滾動（扣除 header 84px offset）
    allLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-target');
        const targetEl = targetId ? document.getElementById(targetId) : null;

        if (targetEl) {
          e.preventDefault();
          closeMobileSheet();

          const top = targetEl.getBoundingClientRect().top + window.scrollY - 84;
          window.scrollTo({ top, behavior: 'smooth' });

          history.pushState(null, '', `#${targetId}`);
          setActive(targetId);
        }
      });
    });

    // ScrollSpy 滾動監聽（RAF 節流計算，無副作用）
    let isTicking = false;

    function handleScroll() {
      if (isTicking) return;
      isTicking = true;

      window.requestAnimationFrame(() => {
        isTicking = false;
        if (targetElements.length === 0) return;

        const headerOffset = 90;
        let activeTargetId = null;

        if (window.scrollY < 80) {
          activeTargetId = targetElements[0].id;
        } else if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 50) {
          activeTargetId = targetElements[targetElements.length - 1].id;
        } else {
          for (let i = 0; i < targetElements.length; i++) {
            const rect = targetElements[i].getBoundingClientRect();
            if (rect.top <= headerOffset + 60) {
              activeTargetId = targetElements[i].id;
            } else {
              break;
            }
          }
          if (!activeTargetId && targetElements.length > 0) {
            activeTargetId = targetElements[0].id;
          }
        }

        if (activeTargetId) {
          setActive(activeTargetId);
        }
      });
    }

    window.__tocScrollHandler = handleScroll;
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToc);
  } else {
    initToc();
  }

  document.addEventListener('astro:page-load', initToc);
</script>
