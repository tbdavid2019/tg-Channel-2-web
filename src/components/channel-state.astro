---
import Layout from '../layouts/base.astro'
import Header from './header.astro'

const { channel, errorCode, telegramUrl } = Astro.props
const displayChannel = {
  ...channel,
  title: channel?.title || (channel?.handle ? `@${channel.handle}` : 'Telegram 頻道'),
  posts: [],
}

const messages = {
  invite: {
    title: '這是 Telegram 邀請連結',
    description: '邀請連結需要在 Telegram 裡加入，沒有可供網站讀取的公開歷史訊息。',
  },
  private: {
    title: '這是私人訊息連結',
    description: '私人群組或私人頻道的訊息需要登入 Telegram，公開網站無法讀取。',
  },
  no_public_preview: {
    title: '這個連結沒有公開訊息預覽',
    description: '常見原因是它是群組、已限制公開預覽，或連結已失效。這類內容需要直接在 Telegram 開啟。',
  },
  fetch_failed: {
    title: '暫時無法連線到 Telegram',
    description: 'Telegram 暫時沒有回應，請稍後再試。',
  },
  empty_response: {
    title: 'Telegram 沒有回傳內容',
    description: '這個連結目前沒有可顯示的公開內容。',
  },
  invalid: {
    title: 'Telegram 連結格式不正確',
    description: '請輸入 @username、username，或完整的 t.me 公開連結。',
  },
  empty: {
    title: '請輸入 Telegram 頻道或群組',
    description: '請輸入 @username、username，或完整的 t.me 公開連結。',
  },
}

const message = messages[errorCode] || messages.no_public_preview
---

<Layout channel={displayChannel}>
  <slot name="header">
    <Header channel={displayChannel} />
  </slot>

  <section class="channel-state" aria-live="polite">
    <p class="status-eyebrow">TELEGRAM STATUS</p>
    <h1>{message.title}</h1>
    <p>{message.description}</p>
    <div class="channel-state-actions">
      {telegramUrl && <a href={telegramUrl} target="_blank" rel="noopener">在 Telegram 開啟</a>}
      <a href="/">重新輸入</a>
    </div>
  </section>
</Layout>

<style>
  .channel-state {
    max-width: 72ch;
    padding: clamp(30px, 6vw, 64px) clamp(22px, 5vw, 56px);
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--box-border-radius);
    box-shadow: var(--shadows);
  }

  .status-eyebrow {
    margin: 0 0 18px;
    color: var(--accent-color);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
  }

  .channel-state h1 {
    margin: 0 0 18px;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.4;
  }

  .channel-state p {
    margin: 0;
    color: var(--secondary-color);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .channel-state-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .channel-state-actions a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 8px 18px;
    border: 1px solid var(--border-color);
    border-radius: var(--box-border-radius);
    background: var(--code-background-color);
    font-size: 1rem;
  }

  .channel-state-actions a:first-child {
    border-color: var(--accent-color);
    background: var(--accent-color);
    color: var(--surface-color);
  }

  .channel-state-actions a:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }
</style>
