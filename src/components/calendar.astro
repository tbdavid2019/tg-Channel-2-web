---
import dayjs from '../lib/dayjs'
import 'dayjs/locale/zh-tw'
import { getEnv } from '../lib/env'
import { getDatesWithPosts, getDatesByMonth } from '../lib/db'

const rawSiteUrl = Astro.locals.SITE_URL || '/'
// Strip accidental http://localhost or host prefixes for clean relative links
const SITE_URL = rawSiteUrl.replace(/^https?:\/\/[^/]+/i, '') || '/'
const locale = getEnv(import.meta.env, Astro, 'LOCALE') || 'en'
const tz = getEnv(import.meta.env, Astro, 'TIMEZONE') || 'Asia/Taipei'
const currentChannel = Astro.params?.channel || getEnv(import.meta.env, Astro, 'CHANNEL') || ''

dayjs.locale(locale)

// Get current month from URL or default to today in target timezone
const urlMonth = Astro.url.searchParams.get('month')
const today = dayjs().tz(tz)
// If month param exists, use it, otherwise use current date in target timezone
const targetDate = urlMonth ? dayjs(urlMonth).tz(tz) : today
const currentMonth = targetDate.startOf('month')

// Get dates with posts for the target month
let datesWithPosts = []
try {
  // We need to fetch all posts for the target month
  // The DB function expects 'YYYY-MM' format and respects timezone
  const yearMonth = currentMonth.format('YYYY-MM')
  if (getDatesByMonth) {
    datesWithPosts = getDatesByMonth(yearMonth, currentChannel, tz)
  } else {
    datesWithPosts = getDatesWithPosts(31, currentChannel, tz) 
  }
} catch (e) {
  console.error('Failed to get dates with posts:', e.message)
}

// Build a set for quick lookup
const postDatesSet = new Set(datesWithPosts.map(d => d.date))
const postCountMap = new Map(datesWithPosts.map(d => [d.date, d.count]))

// Calendar grid calculation
const daysInMonth = currentMonth.daysInMonth()
const firstDayOfWeek = currentMonth.day()

// Generate calendar grid using functional approach
const emptyDays = Array.from({ length: firstDayOfWeek }, () => null)
const monthDays = Array.from({ length: daysInMonth }, (_, i) => {
  const day = i + 1
  const date = currentMonth.date(day).format('YYYY-MM-DD')
  return {
    day,
    date,
    hasPost: postDatesSet.has(date),
    count: postCountMap.get(date) || 0,
    isToday: date === today.format('YYYY-MM-DD')
  }
})
const calendarDays = [...emptyDays, ...monthDays]

const weekDays = locale.startsWith('zh') 
  ? ['日', '一', '二', '三', '四', '五', '六']
  : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']

// Navigation Links
const prevMonth = currentMonth.subtract(1, 'month')
const nextMonth = currentMonth.add(1, 'month')
const prevLink = `?month=${prevMonth.format('YYYY-MM')}`
// Only show next link if it's not in the future (optional limitation, but good for UI)
// Actually we can allow future to see 0 posts.
const nextLink = `?month=${nextMonth.format('YYYY-MM')}`
---

<div class="calendar-container">
  <div class="calendar-header">
    <a href={prevLink} class="nav-btn" title="上個月" data-i18n-title="previousMonth">&lt;</a>
    <span class="calendar-title" data-i18n-month={currentMonth.format('YYYY-MM')}>
      {currentMonth.format('YYYY年M月')}
    </span>
    <a href={nextLink} class="nav-btn" title="下個月" data-i18n-title="nextMonth">&gt;</a>
  </div>
  
  <div class="calendar-grid">
    {weekDays.map(day => (
      <div class="calendar-weekday" data-i18n-weekday={weekDays.indexOf(day)}>{day}</div>
    ))}
    
    {calendarDays.map(item => (
      item === null ? (
        <div class="calendar-day empty"></div>
      ) : item.hasPost ? (
        <a 
          href={`${SITE_URL}date/${item.date}`} 
          class={`calendar-day has-post ${item.isToday ? 'today' : ''}`}
          title={`${item.count} 篇文章`}
          data-i18n-title="dayArticleCount"
          data-i18n-count={item.count}
        >
          {item.day}
          <span class="post-indicator"></span>
        </a>
      ) : (
        <div class={`calendar-day ${item.isToday ? 'today' : ''}`}>
          {item.day}
        </div>
      )
    ))}
  </div>
</div>

<style>
  .calendar-container {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    padding: 18px 20px;
    box-shadow: var(--shadows);
    margin-bottom: 24px;
  }

  .calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding: 0 4px;
  }

  .calendar-title {
    font-family: var(--font-brand);
    font-size: var(--text-h3, 1.125rem);
    font-weight: 700;
    color: var(--deep-blue);
  }
  
  .nav-btn {
    display: inline-grid;
    min-width: 36px;
    min-height: 36px;
    place-items: center;
    text-decoration: none;
    color: var(--deep-blue);
    font-weight: bold;
    padding: 2px 8px;
    background: var(--input-bg);
    border: 1.5px solid var(--card-border);
    border-radius: 6px;
    transition: all 0.15s ease;
  }
  
  .nav-btn:hover {
    background-color: var(--primary);
    color: var(--ink);
    border-color: var(--input-border);
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  .calendar-weekday {
    text-align: center;
    font-size: var(--text-meta, 0.875rem);
    color: var(--text-muted);
    padding: 6px 2px;
    font-weight: 700;
  }

  .calendar-day {
    position: relative;
    text-align: center;
    min-height: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4px 2px;
    font-size: var(--text-ui, 0.9375rem);
    line-height: 1;
    border-radius: 8px;
    color: var(--text-muted);
    transition: all 0.15s ease;
  }

  .calendar-day.empty {
    visibility: hidden;
  }

  .calendar-day.today {
    background: var(--deep-blue);
    color: var(--warm-cream);
    font-weight: 700;
  }

  .calendar-day.has-post {
    color: var(--ink);
    font-weight: 700;
    background: var(--canvas);
    cursor: pointer;
    text-decoration: none;
  }

  .calendar-day.has-post:hover {
    background: var(--primary);
    color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(43, 37, 26, 0.12);
  }

  .calendar-day.has-post .post-indicator {
    position: absolute;
    bottom: 3px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    background: var(--clay);
    border-radius: 50%;
  }

  .calendar-day.has-post:hover .post-indicator {
    background: var(--ink);
  }

  .calendar-day.today.has-post .post-indicator {
    background: var(--primary);
  }

  @media screen and (max-width: 640px) {
    .calendar-container {
      padding: 12px 10px;
      margin-bottom: 18px;
    }

    .calendar-grid {
      gap: 2px;
    }

    .calendar-day {
      min-height: 36px;
      font-size: 0.875rem;
      border-radius: 6px;
    }

    .calendar-title {
      font-size: 1rem;
    }

    .nav-btn {
      min-width: 32px;
      min-height: 32px;
    }
  }
</style>
