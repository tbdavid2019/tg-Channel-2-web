---
import { getRecentChannels } from '../lib/db'
import { getEnv } from '../lib/env'
import { Crown, ArrowRight } from 'lucide-astro'

const PINNED_HANDLE = 'oliservice'
const PINNED_DEFAULT_TITLE = '選出潛力股 | 投資新聞濃縮包 | 333'

const { channels, limit = 30, currentHandle = '' } = Astro.props
const rawRecent = channels ?? getRecentChannels(limit, { pinHandle: PINNED_HANDLE })

const visitedChannels = Array.isArray(rawRecent) ? rawRecent : []
const pinnedChannel = visitedChannels.find(channel => channel.handle.toLowerCase() === PINNED_HANDLE) || {
  handle: PINNED_HANDLE,
  title: PINNED_DEFAULT_TITLE,
  count: 0,
}

// Keep the golden seat while ranking every other channel by recorded seven-day visits.
const otherSorted = visitedChannels
  .filter(c => c.handle.toLowerCase() !== PINNED_HANDLE)
  .sort((a, b) => (b.count || 0) - (a.count || 0) || (b.lastVisitedAt || 0) - (a.lastVisitedAt || 0))

const recentChannels = limit > 0
  ? [pinnedChannel, ...otherSorted.slice(0, Math.max(0, limit - 1))]
  : []

const anyChannel = getEnv(import.meta.env, Astro, 'ANYCHANNEL') === 'true'
const defaultChannel = (getEnv(import.meta.env, Astro, 'CHANNEL') || '').toLowerCase()
const readerBase = getEnv(import.meta.env, Astro, 'READER_URL') || 'https://telegram.david888.com'

function getChannelHref(handle) {
  const norm = handle.toLowerCase()
  if (anyChannel) {
    return `/${handle}/`
  }
  if (norm === defaultChannel || (currentHandle && norm === currentHandle.toLowerCase())) {
    return '/'
  }
  return `${readerBase}/${handle}/`
}

const extraCount = Math.max(0, recentChannels.length - 10)
---

{
  recentChannels && recentChannels.length > 0 && (
    <section class="popular-channels" aria-labelledby="popular-aside-title">
      <div class="popular-heading">
        <p class="eyebrow" data-i18n="popularKicker">DISCOVERY</p>
        <h2 id="popular-aside-title" data-i18n="popularTitle">近 7 天熱門頻道</h2>
        <p data-i18n="popularDescription">曾有人瀏覽過的公開頻道，依近 7 天使用次數排序。</p>
      </div>
      <ol class="popular-list">
        {recentChannels.map((recentChannel, index) => {
          const isCurrent = currentHandle && recentChannel.handle.toLowerCase() === currentHandle.toLowerCase()
          const isPinned = recentChannel.handle.toLowerCase() === PINNED_HANDLE
          const isExtra = index >= 10
          return (
            <li class={isExtra ? 'popular-item-extra' : ''}>
              <a
                href={getChannelHref(recentChannel.handle)}
                class={`popular-channel-link ${isCurrent ? 'is-current' : ''} ${isPinned ? 'is-golden' : ''}`}
                aria-current={isCurrent ? 'page' : undefined}
                title={recentChannel.title}
              >
                <span class="popular-rank">{String(index + 1).padStart(2, '0')}</span>
                <span class="popular-channel-copy">
                  <span class="popular-channel-title-row">
                    <strong class="popular-channel-title">{recentChannel.title}</strong>
                    {isPinned && (
                      <span class="pinned-indicator golden-badge" title="黃金席位 · 官方預設保留">
                        <Crown size={12} class="golden-crown-icon" aria-hidden="true" />
                        <span>黃金席位</span>
                      </span>
                    )}
                  </span>
                  <small class="popular-channel-meta">@{recentChannel.handle} · <span data-i18n="popularViews" data-i18n-count={recentChannel.count}>{(recentChannel.count || 0).toLocaleString()} 次瀏覽</span></small>
                </span>
                <ArrowRight size={14} class="popular-arrow" aria-hidden="true" />
              </a>
            </li>
          )
        })}
      </ol>
      {extraCount > 0 && (
        <div class="popular-actions">
          <button
            type="button"
            class="popular-more-btn"
            id="popular-more-toggle"
            aria-expanded="false"
            data-extra-count={extraCount}
          >
            <span class="popular-more-text" data-i18n="popularMoreToggle">
              查看更多頻道 (展開 {extraCount} 個遺珠)
            </span>
            <span class="popular-more-arrow" aria-hidden="true">↓</span>
          </button>
        </div>
      )}
    </section>
  )
}

<script>
  function setupPopularToggle() {
    const toggleBtn = document.getElementById('popular-more-toggle')
    const container = toggleBtn?.closest('.popular-channels')
    if (!toggleBtn || !container) return

    toggleBtn.addEventListener('click', () => {
      const isExpanded = container.classList.toggle('is-expanded')
      toggleBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false')
      const textEl = toggleBtn.querySelector('.popular-more-text')
      const arrowEl = toggleBtn.querySelector('.popular-more-arrow')
      const count = toggleBtn.dataset.extraCount || ''
      if (isExpanded) {
        if (textEl) textEl.textContent = '收合熱門清單'
        if (arrowEl) arrowEl.textContent = '↑'
      } else {
        if (textEl) textEl.textContent = `查看更多頻道 (展開 ${count} 個遺珠)`
        if (arrowEl) arrowEl.textContent = '↓'
      }
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPopularToggle)
  } else {
    setupPopularToggle()
  }
</script>

<style>
  .popular-channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 18px;
    border: 1px solid var(--border-color);
    border-radius: var(--box-border-radius);
    background: var(--surface-color);
    box-shadow: var(--shadows);
  }

  @media screen and (min-width: 961px) {
    .popular-channels {
      position: sticky;
      top: calc(64px + 16px);
      align-self: flex-start;
      width: 100%;
      max-height: calc(100vh - 96px);
      overflow-y: auto;
      scrollbar-width: thin;
      overscroll-behavior: contain;
    }
  }

  .popular-item-extra {
    display: none;
  }

  .popular-channels.is-expanded .popular-item-extra {
    display: list-item;
  }

  .popular-actions {
    margin-top: 4px;
    padding-top: 10px;
    border-top: 1px dashed var(--input-border);
  }

  .popular-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--input-border);
    border-radius: 8px;
    background: var(--canvas);
    color: var(--deep-blue);
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .popular-more-btn:hover {
    background: var(--primary);
    border-color: var(--ink);
    color: var(--ink);
  }

  .popular-more-arrow {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .popular-heading .eyebrow {
    margin: 0 0 6px;
    color: var(--clay);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .popular-heading h2 {
    margin: 0;
    color: var(--deep-blue);
    font-family: var(--font-brand);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .popular-heading p:last-child {
    margin: 6px 0 0;
    color: var(--secondary-color);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .popular-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .popular-channel-link {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--foreground-color);
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .popular-channel-link:hover {
    background: var(--canvas);
    text-decoration: none;
  }

  .popular-channel-link.is-current {
    background: var(--canvas);
    font-weight: 700;
  }

  .popular-rank {
    color: var(--deep-blue);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .popular-channel-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 2px;
  }

  .popular-channel-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .popular-channel-title,
  .popular-channel-meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .popular-channel-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
  }

  .pinned-indicator.golden-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--primary);
    color: var(--ink);
    border: 1px solid var(--input-border);
    line-height: 1.3;
    white-space: nowrap;
  }

  .popular-channel-link.is-golden:not(.is-current) {
    background: color-mix(in srgb, var(--primary) 12%, var(--surface-color));
  }

  .popular-channel-meta {
    color: var(--secondary-color);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .popular-arrow {
    color: var(--clay);
    font-size: 0.875rem;
    transition: transform 0.15s ease;
  }

  .popular-channel-link:hover .popular-arrow {
    transform: translateX(3px);
  }
</style>
