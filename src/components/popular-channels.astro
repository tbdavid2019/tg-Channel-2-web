---
import { getRecentChannels } from '../lib/db'
import { getEnv } from '../lib/env'

const { channels, limit = 10, currentHandle = '' } = Astro.props
const rawRecent = channels ?? getRecentChannels(limit)

const defaultChannels = [
  { handle: 'oliservice', title: '選出潛力股 | 投資新聞濃縮包 | 333', count: 1200 },
  { handle: 'daybuy', title: 'Costco好市多(新品/優惠)最速報', count: 1000 },
  { handle: 'backpackerscomtw', title: '背包客棧', count: 980 },
  { handle: 'mikuri520', title: "BennyThink's Blog", count: 197 },
  { handle: 'weekly_books', title: '小聲讀書 🙈', count: 172 },
  { handle: 'twtrailers', title: '台灣最新電影預告片', count: 149 },
  { handle: 'worldnewshome', title: '全球新聞快訊(中文)', count: 144 },
  { handle: 'scheeinfo', title: 'Schee.info @ Telegram', count: 79 },
  { handle: 'wordpress', title: 'WordPress | @GlobalUsername', count: 63 },
]

const channelMap = new Map()

// 1. Seed with curated default network channels
for (const def of defaultChannels) {
  channelMap.set(def.handle.toLowerCase(), { ...def })
}

// 2. Merge with live visit data
for (const raw of (rawRecent || [])) {
  const handle = raw.handle.toLowerCase()
  if (channelMap.has(handle)) {
    const existing = channelMap.get(handle)
    channelMap.set(handle, {
      ...existing,
      ...raw,
      count: (existing.count || 0) + (raw.count || 0),
      lastVisitedAt: Math.max(raw.lastVisitedAt || 0, existing.lastVisitedAt || 0),
    })
  } else {
    channelMap.set(handle, { ...raw })
  }
}

// 3. Strictly sort by view count descending, then lastVisitedAt descending
const recentChannels = Array.from(channelMap.values())
  .sort((a, b) => (b.count || 0) - (a.count || 0) || (b.lastVisitedAt || 0) - (a.lastVisitedAt || 0))
  .slice(0, Math.max(0, limit))

const anyChannel = getEnv(import.meta.env, Astro, 'ANYCHANNEL') === 'true'
const defaultChannel = (getEnv(import.meta.env, Astro, 'CHANNEL') || '').toLowerCase()
const readerBase = getEnv(import.meta.env, Astro, 'READER_URL') || 'https://telegram.david888.com'

function getChannelHref(handle) {
  const norm = handle.toLowerCase()
  if (anyChannel) {
    return `/${handle}/`
  }
  if (norm === defaultChannel || (currentHandle && norm === currentHandle.toLowerCase())) {
    return '/'
  }
  return `${readerBase}/${handle}/`
}
---

{
  recentChannels && recentChannels.length > 0 && (
    <section class="popular-channels" aria-labelledby="popular-aside-title">
      <div class="popular-heading">
        <p class="eyebrow" data-i18n="popularKicker">DISCOVERY</p>
        <h2 id="popular-aside-title" data-i18n="popularTitle">近 7 天熱門頻道</h2>
        <p data-i18n="popularDescription">曾有人瀏覽過的公開頻道，依近 7 天使用次數排序。</p>
      </div>
      <ol class="popular-list">
        {recentChannels.map((recentChannel, index) => {
          const isCurrent = currentHandle && recentChannel.handle.toLowerCase() === currentHandle.toLowerCase()
          return (
            <li>
              <a
                href={getChannelHref(recentChannel.handle)}
                class={`popular-channel-link ${isCurrent ? 'is-current' : ''}`}
                aria-current={isCurrent ? 'page' : undefined}
                title={recentChannel.title}
              >
                <span class="popular-rank">{String(index + 1).padStart(2, '0')}</span>
                <span class="popular-channel-copy">
                  <strong class="popular-channel-title">{recentChannel.title}</strong>
                  <small class="popular-channel-meta">@{recentChannel.handle} · <span data-i18n="popularViews" data-i18n-count={recentChannel.count}>{recentChannel.count} 次瀏覽</span></small>
                </span>
                <span class="popular-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          )
        })}
      </ol>
    </section>
  )
}

<style>
  .popular-channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--box-border-radius);
    background: var(--surface-color);
    box-shadow: var(--shadows);
  }

  .popular-heading .eyebrow {
    margin: 0 0 6px;
    color: var(--accent-color);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .popular-heading h2 {
    margin: 0;
    color: var(--foreground-color);
    font-size: 1.125rem;
    line-height: 1.35;
  }

  .popular-heading p:last-child {
    margin: 6px 0 0;
    color: var(--secondary-color);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .popular-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .popular-channel-link {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--foreground-color);
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .popular-channel-link:hover {
    background: var(--code-background-color);
    text-decoration: none;
  }

  .popular-channel-link.is-current {
    background: var(--code-background-color);
    border-left: 3px solid var(--accent-color);
  }

  .popular-rank {
    color: var(--accent-color);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .popular-channel-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 2px;
  }

  .popular-channel-title,
  .popular-channel-meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .popular-channel-title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .popular-channel-meta {
    color: var(--secondary-color);
    font-family: var(--font-mono);
    font-size: 0.725rem;
  }

  .popular-arrow {
    color: var(--accent-color);
    font-size: 0.95rem;
    transition: transform 0.15s ease;
  }

  .popular-channel-link:hover .popular-arrow {
    transform: translateX(3px);
  }
</style>
