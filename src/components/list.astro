---
import Layout from '../layouts/base.astro'
import Header from '../components/header.astro'
import Calendar from '../components/calendar.astro'
import Item from '../components/item.astro'
import dayjs from 'dayjs'
import timezone from 'dayjs/plugin/timezone'
import utc from 'dayjs/plugin/utc'
import { getEnv } from '../lib/env'

dayjs.extend(utc)
dayjs.extend(timezone)

const { SITE_URL } = Astro.locals
const { channel, before = true, after = true, isItem = false, showCalendar = true } = Astro.props
const posts = channel.posts ?? []
const tz = getEnv(import.meta.env, Astro, 'TIMEZONE') ?? 'UTC'

// Save posts to database for indexing
let savePosts
try {
  const db = await import('../lib/db')
  savePosts = db.savePosts
  if (posts.length > 0) {
    savePosts(posts, channel.handle)
  }
} catch (e) {
  console.error('Failed to save posts to database:', e.message)
}

// Get unique dates from posts for date-based pagination
const postDates = [...new Set(posts.map(post => 
  dayjs(post.datetime).tz(tz).format('YYYY-MM-DD')
))].sort().reverse()

const dayGroups = []
for (const post of posts) {
  const date = dayjs(post.datetime).tz(tz)
  const dateKey = date.format('YYYY-MM-DD')
  const lastGroup = dayGroups.at(-1)

  if (!lastGroup || lastGroup.dateKey !== dateKey) {
    dayGroups.push({
      dateKey,
      dateLabel: date.format('YYYY · MM · DD'),
      posts: [post],
    })
  } else {
    lastGroup.posts.push(post)
  }
}

// Get today and yesterday for pagination
const today = dayjs().tz(tz).format('YYYY-MM-DD')
const yesterday = dayjs().tz(tz).subtract(1, 'day').format('YYYY-MM-DD')

// For cursor-based pagination fallback
const beforeCursor = posts[posts.length - 1]?.id
const afterCursor = posts[0]?.id
---

<Layout channel={channel} id="main-container">
  <slot name="header">
    <Header channel={channel} />
  </slot>
  {!channel?.isReaderHome && channel?.title && <h1 class="channel-page-title">{channel.title}</h1>}

  {showCalendar && <Calendar />}
  
  <slot />

  <div class="items">
    {
      dayGroups.map((dayGroup) => (
        <section class="day-group" aria-label={`${dayGroup.dateKey} 的文章`}>
          <header class="day-marker" id={`day-${dayGroup.dateKey}`}>
            <time datetime={dayGroup.dateKey}>{dayGroup.dateLabel}</time>
            <span data-i18n="articleCount" data-i18n-count={dayGroup.posts.length}>{dayGroup.posts.length} 篇</span>
          </header>
          <div class="day-group-items">
            {dayGroup.posts.map((post) => <Item post={{ ...post, channel: channel.handle }} isItem={isItem} />)}
          </div>
        </section>
      ))
    }
  </div>

  <div class="pages-container">
    {
      before && beforeCursor > 1 ? (
      <a href={`${SITE_URL}before/${beforeCursor}`} title="更早的文章" data-i18n-title="olderPosts" class="page">
          <span data-i18n="olderPosts">← 更早的文章</span>
        </a>
      ) : (
        <span class="page-placeholder">&nbsp;</span>
      )
    }

    <div class="pages-info">
      {postDates.length > 0 && (
        <a href={`${SITE_URL}date/${postDates[0]}`} class="date-link" title="依日期瀏覽" data-i18n-title="browseByDate">
          {dayjs(String(postDates[0])).format('M/D')} <span data-i18n="browseByDate">依日期瀏覽</span>
        </a>
      )}
    </div>
    {
      after && afterCursor ? (
        <a href={`${SITE_URL}after/${afterCursor}`} title="更新文章" data-i18n-title="newerPosts" class="page">
          <span data-i18n="newerPosts">更新文章 →</span>
        </a>
      ) : (
        <span class="page-placeholder">&nbsp;</span>
      )
    }
  </div>
</Layout>

<style>
  .channel-page-title {
    margin: 0 0 24px;
    color: var(--foreground-color);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.35;
  }

  .date-link {
    color: var(--accent-color);
    text-decoration: none;
    font-size: 0.9em;
  }
  
  .date-link:hover {
    text-decoration: underline;
  }
</style>
