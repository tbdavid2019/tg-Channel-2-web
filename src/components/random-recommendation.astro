---
import { getRandomChannel } from '../lib/recommendations'
import { getEnv } from '../lib/env'
import { Dices, RotateCw, ArrowRight } from 'lucide-astro'

const { currentHandle = '' } = Astro.props
const initialChannel = getRandomChannel(currentHandle)

const anyChannel = getEnv(import.meta.env, Astro, 'ANYCHANNEL') === 'true'
const readerBase = getEnv(import.meta.env, Astro, 'READER_URL') || 'https://telegram.david888.com'

function getChannelHref(handle) {
  if (anyChannel) return `/${handle}/`
  return `${readerBase.replace(/\/+$/, '')}/${handle}/`
}
---

<div class="sidebar-card random-recommend-card" id="random-recommend-card" data-any-channel={anyChannel ? 'true' : 'false'} data-reader-base={readerBase}>
  <div class="random-card-header">
    <div class="random-title-wrap">
      <span class="random-badge">
        <Dices size={14} class="random-badge-icon" aria-hidden="true" />
        <span data-i18n="randomRecommendBadge">隨機探索</span>
      </span>
    </div>
    <button type="button" class="random-reroll-btn" id="random-reroll-btn" title="換一個" data-i18n-title="randomReroll">
      <RotateCw size={14} class="reroll-icon" id="random-reroll-icon" aria-hidden="true" />
      <span class="reroll-text" data-i18n="randomChange">換一個</span>
    </button>
  </div>

  <div class="random-card-body">
    <a href={getChannelHref(initialChannel.handle)} class="random-channel-link" id="random-channel-link">
      <div class="random-channel-info">
        <h4 class="random-channel-title" id="random-channel-title">{initialChannel.title}</h4>
        <span class="random-channel-handle" id="random-channel-handle">@{initialChannel.handle}</span>
        {initialChannel.description && (
          <p class="random-channel-desc" id="random-channel-desc">{initialChannel.description}</p>
        )}
      </div>
      <div class="random-card-footer">
        <span class="random-category-tag" id="random-category-tag">#{initialChannel.category || '精選'}</span>
        <span class="random-action-btn">
          <span data-i18n="randomReadNow">立即閱讀</span>
          <ArrowRight size={13} style="display: inline-block; vertical-align: middle; margin-left: 2px;" />
        </span>
      </div>
    </a>
  </div>
</div>

<script>
  const card = document.getElementById('random-recommend-card')
  const rerollBtn = document.getElementById('random-reroll-btn')
  const icon = document.getElementById('random-reroll-icon')
  const link = document.getElementById('random-channel-link')
  const titleEl = document.getElementById('random-channel-title')
  const handleEl = document.getElementById('random-channel-handle')
  const descEl = document.getElementById('random-channel-desc')
  const tagEl = document.getElementById('random-category-tag')

  if (rerollBtn && card) {
    const isAnyChannel = card.dataset.anyChannel === 'true'
    const readerBase = card.dataset.readerBase || 'https://telegram.david888.com'

    rerollBtn.addEventListener('click', async () => {
      if (icon) icon.classList.add('is-spinning')
      try {
        const currentHandle = handleEl ? handleEl.textContent.replace('@', '') : ''
        const res = await fetch(`/random?json=1&exclude=${encodeURIComponent(currentHandle)}`)
        if (!res.ok) throw new Error('Fetch failed')
        const data = await res.json()
        if (data && data.channel) {
          const ch = data.channel
          if (titleEl) titleEl.textContent = ch.title || ch.handle
          if (handleEl) handleEl.textContent = `@${ch.handle}`
          if (descEl) descEl.textContent = ch.description || ''
          if (tagEl) tagEl.textContent = `#${ch.category || '精選'}`
          if (link) {
            link.setAttribute('href', isAnyChannel ? `/${ch.handle}/` : `${readerBase.replace(/\/+$/, '')}/${ch.handle}/`)
          }
        }
      } catch (err) {
        console.warn('Reroll random channel error:', err)
      } finally {
        if (icon) {
          setTimeout(() => icon.classList.remove('is-spinning'), 300)
        }
      }
    })
  }
</script>

<style>
  .random-recommend-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    padding: 18px 18px;
    box-shadow: var(--shadows);
    margin-bottom: 20px;
    transition: all 0.2s ease;
  }

  .random-recommend-card:hover {
    border-color: var(--input-border);
    box-shadow: 0 4px 14px rgba(43, 37, 26, 0.08);
  }

  .random-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--card-border-subtle);
  }

  .random-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--primary);
    border: 1px solid var(--input-border);
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.02em;
  }

  .random-reroll-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--input-bg);
    border: 1.5px solid var(--card-border);
    border-radius: 6px;
    padding: 4px 9px;
    color: var(--deep-blue);
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .random-reroll-btn:hover {
    background: var(--primary);
    color: var(--ink);
    border-color: var(--input-border);
  }

  .reroll-icon {
    display: inline-block;
    font-size: 0.8125rem;
    transition: transform 0.3s ease;
  }

  .reroll-icon.is-spinning {
    transform: rotate(360deg);
  }

  .random-channel-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .random-channel-title {
    margin: 0 0 4px 0;
    font-family: var(--font-brand);
    font-size: 1rem;
    font-weight: 700;
    color: var(--deep-blue);
    line-height: 1.35;
    word-break: break-word;
    transition: color 0.15s ease;
  }

  .random-channel-handle {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--clay);
    margin-bottom: 6px;
  }

  .random-channel-desc {
    margin: 0 0 10px 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .random-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--card-border-subtle);
  }

  .random-category-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--clay);
    background: var(--canvas);
    border: 1px solid var(--card-border);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .random-action-btn {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--deep-blue);
    transition: transform 0.18s ease, color 0.18s ease;
  }

  .random-channel-link:hover .random-action-btn {
    color: var(--clay);
    transform: translateX(3px);
  }

  .random-channel-link:hover .random-channel-title {
    color: var(--clay);
  }
</style>
