---
import { getEnv } from '../lib/env'
import { sanitizeDescription } from '../lib/telegram/sanitize'
import rss from '../assets/rss.svg'
import podcast from '../assets/podcast.svg'
import twitter from '../assets/twitter.svg'
import github from '../assets/github.svg'
import discord from '../assets/discord.svg'
import telegram from '../assets/telegram.svg'
import mastodon from '../assets/mastodon.svg'
import bluesky from '../assets/bluesky.svg'

const { SITE_URL, RSS_URL } = Astro.locals
const { channel } = Astro.props

const PODCASRT = getEnv(import.meta.env, Astro, 'PODCASRT')
const TWITTER = getEnv(import.meta.env, Astro, 'TWITTER')
const GITHUB = getEnv(import.meta.env, Astro, 'GITHUB')
const TELEGRAM = getEnv(import.meta.env, Astro, 'TELEGRAM')
const DISCORD = getEnv(import.meta.env, Astro, 'DISCORD')
const MASTODON = getEnv(import.meta.env, Astro, 'MASTODON')
const BLUESKY = getEnv(import.meta.env, Astro, 'BLUESKY')

// In ANYCHANNEL mode, don't use proxy - direct CDN access works better
const anyChannel = getEnv(import.meta.env, Astro, 'ANYCHANNEL')
const staticProxy = anyChannel ? '' : (getEnv(import.meta.env, Astro, 'STATIC_PROXY') ?? '/static/')
const hideDescription = getEnv(import.meta.env, Astro, 'HIDE_DESCRIPTION')
const safeDescriptionHTML = channel?.descriptionHTML ? sanitizeDescription(channel.descriptionHTML) : ''
const brand = '888 Telegram 頻道瀏覽器'
const isAnyChannel = anyChannel === 'true'
const homeUrl = isAnyChannel ? '/' : (getEnv(import.meta.env, Astro, 'READER_URL') || 'https://telegram.david888.com/')
const channelTitle = channel?.title || (channel?.handle ? `@${channel.handle}` : brand)

const locale = getEnv(import.meta.env, Astro, 'LOCALE')
const initialLanguage = String(locale || '').toLowerCase().startsWith('zh') ? 'zh-Hant' : 'en'
const isZh = initialLanguage === 'zh-Hant'

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isHome = Boolean(channel?.isReaderHome)
const channelUrl = isAnyChannel ? (channel?.handle ? `/${channel.handle}/` : SITE_URL) : '/'
const hasChannelCrumb = Boolean(channel?.handle || (channel?.title && channel?.title !== brand))

// Check subpages
let subPageTitle = ''
const postMatch = pathname.match(/\/posts\/(\d+)/)
const dateMatch = pathname.match(/\/date\/([\d-]+)/)

if (postMatch) {
  subPageTitle = `貼文 #${postMatch[1]}`
} else if (dateMatch) {
  subPageTitle = dateMatch[1]
} else if (pathname.endsWith('/tags')) {
  subPageTitle = '標籤'
} else if (pathname.endsWith('/links')) {
  subPageTitle = '連結'
} else if (pathname.startsWith('/search/')) {
  const query = decodeURIComponent(pathname.replace('/search/', ''))
  subPageTitle = query ? `搜尋：${query}` : '搜尋'
}
---

<div id="header">
  <div class="header-main">
    {isHome ? (
      <div class="header-brand-wrap">
        <a href="/" title={brand} class="avatar-link brand-avatar-link">
          <img
            src="/favicon.svg?v=seo-20260904"
            alt={brand}
            loading="eager"
            class="header-avatar brand-avatar"
          />
        </a>
        <div class="header-title">
          <a href="/" class="site-title brand-title" title={brand}>
            {brand}
          </a>
        </div>
      </div>
    ) : (
      <nav class="breadcrumb-trail" aria-label="麵包屑導航">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item breadcrumb-home">
            <a href={homeUrl} title={brand} class="breadcrumb-link home-link">
              <img
                src="/favicon.svg?v=seo-20260904"
                alt={brand}
                loading="eager"
                class="header-avatar breadcrumb-brand-icon"
              />
              <span class="breadcrumb-text breadcrumb-brand-title">{brand}</span>
            </a>
          </li>

          {hasChannelCrumb && (
            <>
              <li class="breadcrumb-separator" aria-hidden="true">&gt;</li>
              <li class={`breadcrumb-item breadcrumb-channel ${!subPageTitle ? 'is-current' : ''}`}>
                <a href={channelUrl} title={channelTitle} class="breadcrumb-link channel-link">
                  <img
                    src={channel?.avatar?.startsWith('http') ? staticProxy + channel?.avatar : '/favicon.svg?v=seo-20260904'}
                    alt={channelTitle}
                    loading="eager"
                    class="header-avatar channel-avatar"
                  />
                  <div class="breadcrumb-channel-info">
                    <span class="breadcrumb-text channel-name">{channelTitle}</span>
                    {channel?.handle && <span class="header-handle">@{channel.handle}</span>}
                  </div>
                </a>
              </li>
            </>
          )}

          {subPageTitle && (
            <>
              <li class="breadcrumb-separator" aria-hidden="true">&gt;</li>
              <li class="breadcrumb-item breadcrumb-subpage is-current" aria-current="page">
                <span class="breadcrumb-text subpage-title">{subPageTitle}</span>
              </li>
            </>
          )}
        </ol>
      </nav>
    )}
  </div>



  <div class="header-right">
    <div class="lang-pill-toggle" role="group" aria-label="介面語言" data-i18n-aria-label="languageLabel">
      <button type="button" class="lang-pill-btn" data-language="zh-Hant" aria-pressed={isZh ? "true" : "false"}>繁中</button>
      <button type="button" class="lang-pill-btn" data-language="en" aria-pressed={!isZh ? "true" : "false"}>EN</button>
    </div>

    <div class="header-icons">
      <a href={RSS_URL} target="_blank" rel="alternate" type="application/rss+xml" title="RSS Feed">
        <img {...rss} alt="RSS" class="social-icon" width="1em" />
      </a>

      {
        PODCASRT && (
          <a href={PODCASRT} target="_blank" title="Podcast">
            <img {...podcast} alt="Podcast" class="social-icon" width="1em" />
          </a>
        )
      }

      {
        TWITTER && TWITTER.length > 0 && (
          <a href={`https://twitter.com/${TWITTER}`} title="Twitter" target="_blank">
            <img {...twitter} alt={`twitter.com/${TWITTER}`} class="social-icon" width="1em" />
          </a>
        )
      }

      {
        GITHUB && GITHUB.length > 0 && (
          <a href={`https://github.com/${GITHUB}`} title="GitHub" target="_blank">
            <img {...github} alt={`github.com/${GITHUB}`} class="social-icon" width="1em" />
          </a>
        )
      }

      {
        TELEGRAM && TELEGRAM.length > 0 && (
          <a href={`https://t.me/${TELEGRAM}`} title="Telegram" target="_blank">
            <img {...telegram} alt={`t.me/${TELEGRAM}`} class="social-icon" width="1em" />
          </a>
        )
      }

      {
        DISCORD && DISCORD.length > 0 && (
          <a href={DISCORD} title="Discord" target="_blank">
            <img {...discord} alt="Discord Invite" class="social-icon" width="1em" />
          </a>
        )
      }

      {
        MASTODON && MASTODON.length > 0 && (
          <a href={`https://${MASTODON}`} title="Mastodon" target="_blank">
            <img {...mastodon} alt={`@${MASTODON}`} class="social-icon" width="1em" />
          </a>
        )
      }

      {
        BLUESKY && BLUESKY.length > 0 && (
          <a href={`https://bsky.app/profile/${BLUESKY}`} title="BlueSky" target="_blank">
            <img {...bluesky} alt={`@${BLUESKY}`} class="social-icon" width="1em" />
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .header-main {
    display: flex;
    align-items: center;
    min-width: 0;
    flex: 1;
  }

  .header-brand-wrap {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .breadcrumb-trail {
    display: flex;
    align-items: center;
    min-width: 0;
    width: 100%;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--foreground-color);
    border-radius: 6px;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--accent-color);
    text-decoration: none;
  }

  .breadcrumb-brand-icon {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    flex-shrink: 0;
    border: none;
    box-shadow: none;
  }

  .breadcrumb-brand-title {
    font-size: 1.0625rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--foreground-color);
  }

  .breadcrumb-separator {
    color: var(--secondary-color);
    font-size: 0.95rem;
    font-weight: 600;
    opacity: 0.6;
    user-select: none;
    padding-inline: 2px;
  }

  .channel-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .breadcrumb-channel-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
  }

  .channel-name {
    font-size: 1.0625rem;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 260px;
  }

  .subpage-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent-color);
    white-space: nowrap;
  }

  @media screen and (max-width: 768px) {
    .breadcrumb-list {
      gap: 4px 6px;
    }

    .breadcrumb-brand-title {
      font-size: 0.875rem;
    }

    .channel-name {
      max-width: 140px;
      font-size: 0.875rem;
    }

    .breadcrumb-brand-icon {
      width: 26px;
      height: 26px;
    }

    .channel-avatar {
      width: 26px;
      height: 26px;
    }
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .lang-pill-toggle {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    background: #ebe9f2;
    border: 1px solid #d4d0e2;
    border-radius: 8px;
    gap: 2px;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .lang-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    min-height: 26px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: #4b4b60;
    font-family: var(--font-cjk);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    line-height: 1;
    transition: all 0.18s ease;
  }

  .lang-pill-btn:hover:not([aria-pressed='true']) {
    color: #1a1a24;
  }

  .lang-pill-btn[aria-pressed='true'] {
    background: #7038e8;
    color: #ffffff;
    box-shadow: 0 1px 3px rgba(112, 56, 232, 0.35);
  }

  @media (prefers-color-scheme: dark) {
    .lang-pill-toggle {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.15);
    }
    .lang-pill-btn {
      color: rgba(255, 255, 255, 0.7);
    }
    .lang-pill-btn:hover:not([aria-pressed='true']) {
      color: #ffffff;
    }
    .lang-pill-btn[aria-pressed='true'] {
      background: #7038e8;
      color: #ffffff;
    }
  }

  @media screen and (max-width: 640px) {
    .header-right {
      gap: 6px;
    }
    .lang-pill-btn {
      padding: 3px 7px;
      font-size: 0.75rem;
      min-height: 24px;
    }
  }
</style>

{
  !channel?.isReaderHome && hideDescription !== 'true' && safeDescriptionHTML.length > 0 && (
    <div class="text-box" id="site-intro" set:html={safeDescriptionHTML} />
  )
}

<style>
  #site-intro {
    color: var(--secondary-color);
    background-color: var(--code-background-color);
    word-break: break-word;

    & :global(.emoji) {
      font-style: normal;
      margin-right: 2px;
    }
  }

  .social-icon {
    padding: 4px;
  }

  .header-icons {
    gap: 2px;
  }

  .header-handle {
    display: block;
    margin-top: 2px;
    color: var(--secondary-color);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
  }
</style>
