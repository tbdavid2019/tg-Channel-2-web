---
import { getEnv, assetUrl } from '../lib/env'
import { sanitizeDescription } from '../lib/telegram/sanitize'
import rss from '../assets/rss.svg'
import podcast from '../assets/podcast.svg'
import twitter from '../assets/twitter.svg'
import github from '../assets/github.svg'
import discord from '../assets/discord.svg'
import telegram from '../assets/telegram.svg'
import mastodon from '../assets/mastodon.svg'
import bluesky from '../assets/bluesky.svg'

const { SITE_URL, RSS_URL } = Astro.locals
const { channel } = Astro.props

const PODCASRT = getEnv(import.meta.env, Astro, 'PODCASRT')
const TWITTER = getEnv(import.meta.env, Astro, 'TWITTER')
const GITHUB = getEnv(import.meta.env, Astro, 'GITHUB')
const TELEGRAM = getEnv(import.meta.env, Astro, 'TELEGRAM')
const DISCORD = getEnv(import.meta.env, Astro, 'DISCORD')
const MASTODON = getEnv(import.meta.env, Astro, 'MASTODON')
const BLUESKY = getEnv(import.meta.env, Astro, 'BLUESKY')

// In ANYCHANNEL mode, don't use proxy - direct CDN access works better
const anyChannel = getEnv(import.meta.env, Astro, 'ANYCHANNEL')
const staticProxy = anyChannel ? '' : (getEnv(import.meta.env, Astro, 'STATIC_PROXY') ?? '/static/')
const hideDescription = getEnv(import.meta.env, Astro, 'HIDE_DESCRIPTION')
const safeDescriptionHTML = channel?.descriptionHTML ? sanitizeDescription(channel.descriptionHTML) : ''
const brand = '888 Telegram 頻道瀏覽器'
const isAnyChannel = anyChannel === 'true'
const homeUrl = isAnyChannel ? '/' : (getEnv(import.meta.env, Astro, 'READER_URL') || 'https://telegram.david888.com/')
const channelTitle = channel?.title || (channel?.handle ? `@${channel.handle}` : brand)

const locale = getEnv(import.meta.env, Astro, 'LOCALE')
const initialLanguage = String(locale || '').toLowerCase().startsWith('zh') ? 'zh-Hant' : 'en'
const isZh = initialLanguage === 'zh-Hant'

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isHome = Boolean(channel?.isReaderHome)
const channelUrl = isAnyChannel ? (channel?.handle ? `/${channel.handle}/` : SITE_URL) : '/'
const hasChannelCrumb = Boolean(channel?.handle || (channel?.title && channel?.title !== brand))

// Check subpages
let subPageTitle = ''
const postMatch = pathname.match(/\/posts\/(\d+)/)
const dateMatch = pathname.match(/\/date\/([\d-]+)/)

if (postMatch) {
  subPageTitle = `貼文 #${postMatch[1]}`
} else if (dateMatch) {
  subPageTitle = dateMatch[1]
} else if (pathname.endsWith('/tags')) {
  subPageTitle = '標籤'
} else if (pathname.startsWith('/search/')) {
  const query = decodeURIComponent(pathname.replace('/search/', ''))
  subPageTitle = query ? `搜尋：${query}` : '搜尋'
}
---

<header id="header" class="site-header">
  <div class="header-inner">
    <div class="header-main">
      {isHome ? (
        <div class="header-brand-wrap">
          <a href="/" title={brand} data-i18n-title="brand" class="brand-badge-link">
            <div class="brand-badge" aria-hidden="true">
              <span class="badge-main">888</span>
              <span class="badge-sub">TG view</span>
            </div>
          </a>
          <div class="header-title-box">
            <a href="/" class="site-title brand-title" title={brand} data-i18n-title="brand" data-i18n="brand">
              {brand}
            </a>
            <span class="header-subtitle" data-i18n="publicReader">公開 Telegram 內容閱讀工具</span>
          </div>
        </div>
      ) : (
        <nav class="breadcrumb-trail" aria-label="麵包屑導航" data-i18n-aria-label="breadcrumbNav">
          <ol class="breadcrumb-list">
            <li class="breadcrumb-item breadcrumb-home">
              <a href={homeUrl} title={brand} data-i18n-title="brand" class="breadcrumb-link home-link">
                <div class="brand-badge brand-badge-sm" aria-hidden="true">
                  <span class="badge-main">888</span>
                  <span class="badge-sub">TG view</span>
                </div>
                <span class="breadcrumb-text breadcrumb-brand-title" data-i18n="brand">{brand}</span>
              </a>
            </li>

            {hasChannelCrumb && (
              <>
                <li class="breadcrumb-separator" aria-hidden="true">/</li>
                <li class={`breadcrumb-item breadcrumb-channel ${!subPageTitle ? 'is-current' : ''}`}>
                  <a href={channelUrl} title={channelTitle} class="breadcrumb-link channel-link">
                    <img
                      src={channel?.avatar?.startsWith('http') ? staticProxy + channel?.avatar : assetUrl('/favicon.svg')}
                      alt={channelTitle}
                      loading="eager"
                      class="header-avatar channel-avatar"
                    />
                    <div class="breadcrumb-channel-info">
                      <span class="breadcrumb-text channel-name">{channelTitle}</span>
                      {channel?.handle && <span class="header-handle">@{channel.handle}</span>}
                    </div>
                  </a>
                </li>
              </>
            )}

            {subPageTitle && (
              <>
                <li class="breadcrumb-separator" aria-hidden="true">/</li>
                <li class="breadcrumb-item breadcrumb-subpage is-current" aria-current="page">
                  {pathname.endsWith('/tags') ? (
                    <span class="breadcrumb-text subpage-title" data-i18n="tags">標籤</span>
                  ) : (
                    <span class="breadcrumb-text subpage-title">{subPageTitle}</span>
                  )}
                </li>
              </>
            )}
          </ol>
        </nav>
      )}
    </div>

    <div class="header-right">
      <button
        type="button"
        class="header-open-channel-btn"
        id="quick-channel-trigger"
        aria-haspopup="dialog"
        aria-expanded="false"
        title="輸入並開啟任意 Telegram 公開頻道 (快捷鍵 ⌘K / Ctrl+K)"
      >
        <span class="open-channel-icon" aria-hidden="true">⚡</span>
        <span class="open-channel-text">開啟頻道</span>
        <kbd class="open-channel-kbd">⌘K</kbd>
      </button>

      <a href="/random" class="header-random-link" title="隨機探索 Telegram 公開頻道" data-i18n-title="randomRecommendTitle">
        <span class="random-dice" aria-hidden="true">🎲</span>
        <span class="random-text" data-i18n="randomShort">隨機推薦</span>
      </a>

      <div class="lang-pill-toggle" role="group" aria-label="介面語言" data-i18n-aria-label="languageLabel">
        <button type="button" class="lang-pill-btn" data-language="zh-Hant" aria-pressed={isZh ? "true" : "false"}>繁中</button>
        <button type="button" class="lang-pill-btn" data-language="en" aria-pressed={!isZh ? "true" : "false"}>EN</button>
      </div>

      <div class="header-icons">
        <a href={RSS_URL} target="_blank" rel="alternate" type="application/rss+xml" title="RSS Feed">
          <img src={rss.src || rss} alt="RSS" class="social-icon" width="18" height="18" />
        </a>

        {
          PODCASRT && (
            <a href={PODCASRT} target="_blank" title="Podcast">
              <img src={podcast.src || podcast} alt="Podcast" class="social-icon" width="18" height="18" />
            </a>
          )
        }

        {
          TWITTER && TWITTER.length > 0 && (
            <a href={`https://twitter.com/${TWITTER}`} title="Twitter" target="_blank">
              <img src={twitter.src || twitter} alt={`twitter.com/${TWITTER}`} class="social-icon" width="18" height="18" />
            </a>
          )
        }

        {
          GITHUB && GITHUB.length > 0 && (
            <a href={`https://github.com/${GITHUB}`} title="GitHub" target="_blank">
              <img src={github.src || github} alt={`github.com/${GITHUB}`} class="social-icon" width="18" height="18" />
            </a>
          )
        }

        {
          TELEGRAM && TELEGRAM.length > 0 && (
            <a href={`https://t.me/${TELEGRAM}`} title="Telegram" target="_blank">
              <img src={telegram.src || telegram} alt={`t.me/${TELEGRAM}`} class="social-icon" width="18" height="18" />
            </a>
          )
        }

        {
          DISCORD && DISCORD.length > 0 && (
            <a href={DISCORD} title="Discord" target="_blank">
              <img src={discord.src || discord} alt="Discord Invite" class="social-icon" width="18" height="18" />
            </a>
          )
        }

        {
          MASTODON && MASTODON.length > 0 && (
            <a href={`https://${MASTODON}`} title="Mastodon" target="_blank">
              <img src={mastodon.src || mastodon} alt={`@${MASTODON}`} class="social-icon" width="18" height="18" />
            </a>
          )
        }

        {
          BLUESKY && BLUESKY.length > 0 && (
            <a href={`https://bsky.app/profile/${BLUESKY}`} title="BlueSky" target="_blank">
              <img src={bluesky.src || bluesky} alt={`@${BLUESKY}`} class="social-icon" width="18" height="18" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</header>

{
  !channel?.isReaderHome && hideDescription !== 'true' && safeDescriptionHTML.length > 0 && (
    <div class="channel-intro-banner">
      <div class="channel-intro-inner">
        <div class="channel-intro-content" set:html={safeDescriptionHTML} />
      </div>
    </div>
  )
}

<!-- Quick Channel Modal Dialog -->
<div
  id="quick-channel-dialog"
  class="quick-channel-backdrop"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="quick-channel-heading"
>
  <div class="quick-channel-panel">
    <div class="quick-channel-head">
      <div class="quick-channel-title-group">
        <span class="quick-channel-brand-icon" aria-hidden="true">⚡</span>
        <div>
          <h2 id="quick-channel-heading" class="quick-channel-heading">瀏覽 Telegram 公開頻道</h2>
          <p class="quick-channel-desc">輸入頻道 username 或連結，立即在線閱讀</p>
        </div>
      </div>
      <button type="button" class="quick-channel-close-btn" id="quick-channel-close" aria-label="關閉視窗">✕</button>
    </div>

    <form id="quick-channel-form" class="quick-channel-form" autocomplete="off">
      <div class="quick-channel-input-wrapper">
        <span class="quick-channel-prefix" aria-hidden="true">@</span>
        <input
          type="text"
          id="quick-channel-input"
          class="quick-channel-input"
          placeholder="例如：oliservice 或 t.me/telegramnews"
          autocomplete="off"
          spellcheck="false"
          required
        />
        <button type="submit" class="quick-channel-go-btn">
          前往閱讀 →
        </button>
      </div>
      <p id="quick-channel-feedback" class="quick-channel-feedback" style="display: none;"></p>
    </form>

    <div class="quick-channel-hints">
      <span class="quick-hints-label">熱門探索：</span>
      <div class="quick-hints-chips">
        <button type="button" class="quick-hint-chip" data-channel="oliservice">選出潛力股 (@oliservice)</button>
        <button type="button" class="quick-hint-chip" data-channel="telegramnews">Telegram News</button>
        <button type="button" class="quick-hint-chip" data-channel="durov">Pavel Durov</button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupQuickChannelModal() {
    const trigger = document.getElementById('quick-channel-trigger')
    const dialog = document.getElementById('quick-channel-dialog')
    const closeBtn = document.getElementById('quick-channel-close')
    const form = document.getElementById('quick-channel-form')
    const input = document.getElementById('quick-channel-input') as HTMLInputElement | null
    const feedback = document.getElementById('quick-channel-feedback')
    const hintChips = document.querySelectorAll('.quick-hint-chip')

    if (!trigger || !dialog) return

    function openModal() {
      dialog.classList.add('is-open')
      dialog.setAttribute('aria-hidden', 'false')
      trigger.setAttribute('aria-expanded', 'true')
      document.body.style.overflow = 'hidden'
      setTimeout(() => input?.focus(), 60)
    }

    function closeModal() {
      dialog.classList.remove('is-open')
      dialog.setAttribute('aria-hidden', 'true')
      trigger.setAttribute('aria-expanded', 'false')
      document.body.style.overflow = ''
      if (feedback) {
        feedback.style.display = 'none'
        feedback.textContent = ''
      }
    }

    trigger.addEventListener('click', openModal)
    closeBtn?.addEventListener('click', closeModal)

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeModal()
    })

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault()
        if (dialog.classList.contains('is-open')) {
          closeModal()
        } else {
          openModal()
        }
      }
      if (e.key === 'Escape' && dialog.classList.contains('is-open')) {
        closeModal()
      }
    })

    function navigateToChannel(raw: string) {
      let target = String(raw || '').trim()
      target = target.replace(/^https?:\/\/t\.me\//i, '').replace(/^@/, '').replace(/\/.*$/, '').trim()
      if (/^[a-zA-Z0-9_]{3,64}$/.test(target)) {
        window.location.href = `/${target}/`
      } else {
        if (feedback) {
          feedback.style.display = 'block'
          feedback.textContent = '請輸入正確的 Telegram 頻道 username 或 t.me 連結'
        }
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault()
      if (input) navigateToChannel(input.value)
    })

    hintChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const ch = (chip as HTMLElement).dataset.channel
        if (ch) navigateToChannel(ch)
      })
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupQuickChannelModal)
  } else {
    setupQuickChannelModal()
  }
  document.addEventListener('astro:page-load', setupQuickChannelModal)
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 249, 232, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--card-border);
    box-shadow: 0 4px 16px rgba(43, 37, 26, 0.06);
    transition: box-shadow 0.2s ease;
  }

  /* 2md.aiurl.tw signature saffron top accent bar */
  .site-header::before {
    content: '';
    display: block;
    width: 100%;
    height: 4px;
    background: var(--primary);
  }

  .header-inner {
    width: min(1140px, calc(100% - 32px));
    margin: 0 auto;
    padding: 12px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }

  .header-main {
    display: flex;
    align-items: center;
    min-width: 0;
    flex: 1;
  }

  .header-brand-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .brand-badge-link {
    text-decoration: none;
    display: block;
    flex-shrink: 0;
  }

  /* 888 TG view orange-framed logo badge */
  .brand-badge {
    font-family: var(--font-brand);
    font-weight: 800;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 58px;
    height: 44px;
    padding: 2px 6px;
    border-radius: 8px;
    background: #ff7600;
    border: 2px solid #142436;
    color: #0b1a29;
    line-height: 1;
    letter-spacing: -0.02em;
    user-select: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .brand-badge:hover {
    background: #ff8514;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 118, 0, 0.35);
  }

  .brand-badge .badge-main {
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .brand-badge .badge-sub {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-top: 1px;
    opacity: 0.95;
  }

  .brand-badge-sm {
    min-width: 48px;
    height: 36px;
    padding: 1px 4px;
    border-width: 1.5px;
    border-radius: 6px;
  }

  .brand-badge-sm .badge-main {
    font-size: 0.9375rem;
  }

  .brand-badge-sm .badge-sub {
    font-size: 0.55rem;
  }

  .header-title-box {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
  }

  .brand-title {
    font-family: var(--font-brand);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--deep-blue);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-title:hover {
    color: var(--clay);
    text-decoration: none;
  }

  .header-subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Breadcrumb navigation */
  .breadcrumb-trail {
    display: flex;
    align-items: center;
    min-width: 0;
    width: 100%;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--deep-blue);
    border-radius: 6px;
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--clay);
    text-decoration: none;
  }

  .breadcrumb-brand-title {
    font-family: var(--font-brand);
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--deep-blue);
  }

  .breadcrumb-separator {
    color: var(--card-border);
    font-size: 0.95rem;
    font-weight: 700;
    user-select: none;
    padding-inline: 1px;
  }

  .channel-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid var(--card-border);
    flex-shrink: 0;
    object-fit: cover;
  }

  .breadcrumb-channel-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.2;
  }

  .channel-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--deep-blue);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 240px;
  }

  .header-handle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--clay);
    font-weight: 600;
  }

  .subpage-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--clay);
    white-space: nowrap;
  }

  /* Right-hand controls */
  .header-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* Quick Channel button in header */
  .header-open-channel-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    min-height: 34px;
    background: var(--input-bg);
    border: 1.5px solid var(--input-border);
    border-radius: 8px;
    color: var(--deep-blue);
    font-size: var(--text-meta);
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
    line-height: 1;
  }

  .header-open-channel-btn:hover {
    background: var(--primary);
    border-color: var(--ink);
    color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(43, 37, 26, 0.1);
  }

  .open-channel-icon {
    font-size: 0.875rem;
  }

  .open-channel-kbd {
    display: inline-block;
    padding: 1px 5px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    background: var(--canvas);
    border: 1px solid var(--card-border);
    border-radius: 4px;
    color: var(--text-muted);
    line-height: 1.2;
  }

  .header-random-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    min-height: 34px;
    background: var(--input-bg);
    border: 1.5px solid var(--card-border);
    border-radius: 8px;
    color: var(--deep-blue);
    font-family: var(--font-ui);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    line-height: 1;
    transition: all 0.18s ease;
  }

  .header-random-link:hover {
    background: var(--primary);
    border-color: var(--ink);
    color: var(--ink);
    box-shadow: 0 2px 8px rgba(255, 176, 16, 0.35);
  }

  .random-dice {
    font-size: 0.88rem;
    line-height: 1;
  }

  /* Language toggle in 2md.aiurl.tw deep-blue style */
  .lang-pill-toggle {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    background: var(--input-bg);
    border: 1.5px solid var(--card-border);
    border-radius: 8px;
    gap: 2px;
  }

  .lang-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 9px;
    min-height: 28px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    line-height: 1;
    transition: all 0.15s ease;
  }

  .lang-pill-btn:hover:not([aria-pressed='true']) {
    color: var(--ink);
  }

  .lang-pill-btn[aria-pressed='true'] {
    background: var(--deep-blue);
    color: var(--warm-cream);
    box-shadow: 0 1px 4px rgba(23, 50, 77, 0.25);
  }

  /* Social / RSS icons */
  .header-icons {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .header-icons a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--deep-blue);
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .header-icons a:hover {
    background: var(--canvas);
    border-color: var(--card-border);
  }

  .social-icon {
